//! Comparison: the operator traits and `Ordering`.
//!
//! The `#[lang]` markers bind these declarations to the compiler: the
//! comparison operators constrain and dispatch through them. Their scalar
//! impls are compiler-registered (an `impl` target must be a named type,
//! so `i64 : Ord` cannot be written in source) and lower intrinsically;
//! user types implement the traits like any other.

/// Partial equivalence: `==` and `!=`. `eq` is `==`; `!=` is its negation.
#[lang("partial_eq")]
pub trait PartialEq {
    fn eq(self: Self, other: Self) -> bool;
}

/// Full equivalence, as a marker on top of `PartialEq`: every value equals
/// itself. Floats are `PartialEq` but not `Eq` (`NaN != NaN`).
#[lang("eq")]
pub trait Eq: PartialEq {}

/// Partial order: `<`, `<=`, `>`, `>=`, one method per operator — an
/// operator never swaps its operands, so evaluation order stays source
/// order even for `>` and `>=`.
#[lang("partial_ord")]
pub trait PartialOrd: PartialEq {
    fn lt(self: Self, other: Self) -> bool;
    fn le(self: Self, other: Self) -> bool;
    fn gt(self: Self, other: Self) -> bool;
    fn ge(self: Self, other: Self) -> bool;
}

/// The result of a total comparison. A `[value]` enum: three fieldless
/// variants, passed and matched without any reference counting.
#[lang("ordering")]
pub enum [value] Ordering {
    Less,
    Equal,
    Greater
}

/// Total order.
#[lang("ord")]
pub trait Ord: Eq + PartialOrd {
    fn cmp(self: Self, other: Self) -> Ordering;
}

// The builtin impls, in their special form: an `impl` for a primitive
// target with an empty body. The members are compiler-provided — selection
// of a method-less impl lowers the call intrinsically — and these
// declarations are their source of truth: located, serialized in the
// interface, and completing the operator dispatch for every scalar.
// Floats stop at `PartialOrd` (NaN); everything totally ordered carries
// the full tower.

impl PartialEq for i8 { }
impl PartialEq for i16 { }
impl PartialEq for i32 { }
impl PartialEq for i64 { }
impl PartialEq for u8 { }
impl PartialEq for u16 { }
impl PartialEq for u32 { }
impl PartialEq for u64 { }
impl PartialEq for f16 { }
impl PartialEq for f32 { }
impl PartialEq for f64 { }
impl PartialEq for bfloat16 { }
impl PartialEq for float8 { }
impl PartialEq for bool { }
impl PartialEq for char { }
impl PartialEq for str { }

impl Eq for i8 { }
impl Eq for i16 { }
impl Eq for i32 { }
impl Eq for i64 { }
impl Eq for u8 { }
impl Eq for u16 { }
impl Eq for u32 { }
impl Eq for u64 { }
impl Eq for bool { }
impl Eq for char { }
impl Eq for str { }

impl PartialOrd for i8 { }
impl PartialOrd for i16 { }
impl PartialOrd for i32 { }
impl PartialOrd for i64 { }
impl PartialOrd for u8 { }
impl PartialOrd for u16 { }
impl PartialOrd for u32 { }
impl PartialOrd for u64 { }
impl PartialOrd for f16 { }
impl PartialOrd for f32 { }
impl PartialOrd for f64 { }
impl PartialOrd for bfloat16 { }
impl PartialOrd for float8 { }
impl PartialOrd for bool { }
impl PartialOrd for char { }
impl PartialOrd for str { }

impl Ord for i8 { }
impl Ord for i16 { }
impl Ord for i32 { }
impl Ord for i64 { }
impl Ord for u8 { }
impl Ord for u16 { }
impl Ord for u32 { }
impl Ord for u64 { }
impl Ord for bool { }
impl Ord for char { }
impl Ord for str { }
