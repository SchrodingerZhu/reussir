//! Marker traits the compiler answers itself.

/// Pointer-shaped values (nullable-niche eligible).
#[lang("ptr_like")]
#[sealed]
pub trait PtrLike {}

/// A value may be reached from any thread, concurrently — subsuming both
/// of Rust's `Send` and `Sync` (duplicable rc handles make
/// transfer-without-sharing unprovable, so the two predicates collapse;
/// see the thread-safety design note). Declared for name resolution and
/// bound syntax; ground `Sync` goals are answered *structurally* by the
/// compiler, never by impl search.
#[lang("sync")]
#[sealed]
pub trait Sync {}
