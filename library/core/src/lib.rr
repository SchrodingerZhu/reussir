// The built-in core package. `core::intrinsic` holds the declaration
// sites of the compiler's intrinsic operations, `core::cmp` the
// comparison tower, `core::num` the numeric tower, and `core::marker` the
// compiler-answered markers; the rest of the language-coupled surface
// lands here as the library grows.

pub mod cmp;
pub mod intrinsic;
pub mod marker;
pub mod num;
