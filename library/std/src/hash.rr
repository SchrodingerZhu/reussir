//! Hashing: the `Hash`/`Hasher` traits and two pure value hashers.
//!
//! # Shape
//!
//! `Hasher` is **state-passing**: every write consumes the hasher and
//! returns the advanced one, so hashing threads a value rather than
//! mutating through a reference. `Hash::hash` carries its own bounded
//! generic, so any hashable type feeds any hasher:
//!
//! ```text
//! impl Hash for Point {
//!     fn hash<H: Hasher>(self: Self, state: H) -> H {
//!         state.write_i64(self.x).write_i64(self.y)
//!     }
//! }
//!
//! let digest = fast_hash(point);
//! ```
//!
//! Every write is a method on the hasher, including `write` for nested
//! hashable values, so a composite hashes as one chain rather than a
//! nest of calls.
//!
//! # Choosing a hasher
//!
//! Both hashers are plain `[value]` records — one or four words of state,
//! no allocation, no runtime call — and they absorb the typed write
//! stream word by word.
//!
//! - [`FastHasher`] — the Rust compiler's Fx function: rotate, xor, one
//!   wrapping multiply per word, and the raw state is the digest. The
//!   default for hash tables, where the consumer mixes the digest by
//!   masking it to a bucket index anyway: caches, memoization keys,
//!   maps and sets, bulk deduplication.
//! - [`StrongHasher`] — a portable, aHash-derived hash: each
//!   fixed-size value takes aHash's specialized single-word `update`
//!   path, and finishing adds a folded-multiply avalanche. Use it when the digest
//!   itself is the product rather than an index: content addressing,
//!   change detection and fingerprinting, checksums over structures,
//!   sharding across nodes, or when digests are stored or compared.
//!
//! Neither is keyed with a random seed by default, so neither is a
//! defense against an adversary choosing colliding keys; seed through
//! `from_entropy` if the input is untrusted, and note that neither is a
//! cryptographic hash.
//!
//! # Cost
//!
//! A hasher is a plain value: creating one is free, writes are a few
//! arithmetic instructions, and the whole chain inlines.

// `char` carries no `Num` bound, so the language's `as` casts do not
// apply to it; the code point is obtained across the FFI instead, where
// a Reussir `char` is rendered as a Rust `char`.
#[ffi(import)]
fn char_code(value: char) -> u32 [{ value as u32 }];

/// A hash state that absorbs values and produces a digest.
///
/// Every method consumes `self` and returns the advanced state, so
/// writes chain:
///
/// ```text
/// state.write_i64(self.x).write_i64(self.y)
/// ```
///
/// Signed writes reinterpret as unsigned of the same width, so `-1i64`
/// and `u64::MAX` hash alike — they have the same bits, and nothing here
/// promises otherwise.
pub trait Hasher {
    fn write_u64(self: Self, value: u64) -> Self;
    fn write_u32(self: Self, value: u32) -> Self;
    fn write_u16(self: Self, value: u16) -> Self;
    fn write_u8(self: Self, value: u8) -> Self;
    fn write_i64(self: Self, value: i64) -> Self;
    fn write_i32(self: Self, value: i32) -> Self;
    fn write_i16(self: Self, value: i16) -> Self;
    fn write_i8(self: Self, value: i8) -> Self;
    /// Writes one byte: 1 for true, 0 for false.
    fn write_bool(self: Self, value: bool) -> Self;
    /// Writes the character's code point as a 32-bit value.
    fn write_char(self: Self, value: char) -> Self;
    /// Writes a string's bytes through the hasher's chunked byte
    /// protocol.
    fn write_str(self: Self, value: str) -> Self;
    /// Writes any hashable value, so nested fields chain like scalars.
    fn write<T: Hash>(self: Self, value: T) -> Self;
    /// The digest of everything written so far.
    fn finish(self: Self) -> u64;
    /// A fresh hasher under the implementation's default seed. An
    /// associated function: generic containers construct their hasher
    /// through it (`H::default()`), the stand-in for a builder trait until
    /// associated types exist.
    fn default() -> Self;
    /// A fresh hasher seeded from caller-supplied entropy. What
    /// distinguishes it from a fixed seed is the caller's contract: pass
    /// something an adversary cannot predict (its dispersion is the
    /// implementation's problem), and equal entropy yields equal digests.
    fn from_entropy(entropy: u64) -> Self;
}

/// A type that can feed itself to any `Hasher`.
///
/// Two values that compare equal must write the same byte sequence, or
/// hash-based containers built on this will lose entries.
pub trait Hash {
    fn hash<H: Hasher>(self: Self, state: H) -> H;
}

// Every scalar hashes as its own typed write, so a primitive feeds a
// hasher directly and a composite's `write` chain accepts primitives
// without wrapping. Signed values reinterpret as unsigned of the same
// width and floats stay unhashable, mirroring the `Hasher` write set.

impl Hash for u64 {
    fn hash<H: Hasher>(self: Self, state: H) -> H { state.write_u64(self) }
}

impl Hash for u32 {
    fn hash<H: Hasher>(self: Self, state: H) -> H { state.write_u32(self) }
}

impl Hash for u16 {
    fn hash<H: Hasher>(self: Self, state: H) -> H { state.write_u16(self) }
}

impl Hash for u8 {
    fn hash<H: Hasher>(self: Self, state: H) -> H { state.write_u8(self) }
}

impl Hash for i64 {
    fn hash<H: Hasher>(self: Self, state: H) -> H { state.write_i64(self) }
}

impl Hash for i32 {
    fn hash<H: Hasher>(self: Self, state: H) -> H { state.write_i32(self) }
}

impl Hash for i16 {
    fn hash<H: Hasher>(self: Self, state: H) -> H { state.write_i16(self) }
}

impl Hash for i8 {
    fn hash<H: Hasher>(self: Self, state: H) -> H { state.write_i8(self) }
}

impl Hash for bool {
    fn hash<H: Hasher>(self: Self, state: H) -> H { state.write_bool(self) }
}

impl Hash for char {
    fn hash<H: Hasher>(self: Self, state: H) -> H { state.write_char(self) }
}

// The byte protocols read the payload in word-sized chunks, which needs
// raw-pointer access the surface language cannot express yet. The runtime
// continues each hasher's algorithm from its current state
// (`reussir_rt::hash` mirrors the constants and update shapes in this
// file).
// TODO: migrate to native chunked reads when bare-pointer unsafe
// intrinsics land.
#[ffi(import)]
fn fx_write_str(state: u64, s: str) -> u64 [{
    reussir_rt::hash::fx_write_bytes(state, s.as_bytes())
}];

#[ffi(import)]
fn strong_write_str(buffer: u64, pad: u64, key0: u64, key1: u64, s: str) -> u64 [{
    reussir_rt::hash::strong_write_bytes(buffer, pad, key0, key1, s.as_bytes())
}];

impl Hash for str {
    fn hash<H: Hasher>(self: Self, state: H) -> H {
        state.write_str(self)
    }
}

// ---------------------------------------------------------------- FastHasher

/// The Rust compiler's Fx hash: per word, rotate the state left by five,
/// xor the word in, and one wrapping multiply. The state is the digest —
/// there is no finalizer, which is the point: the table masking the
/// digest down to an index does the only mixing that path needs.
pub struct [value] FastHasher { state : u64 }

// 0x517cc1b727220a95, Fx's multiplier.
fn fast_mix(state : u64, value : u64) -> u64 {
    (((state << 5) | (state >> 59)) ^ value) * 5871781006564002453
}

impl Hasher for FastHasher {
    fn write_u64(self: Self, value: u64) -> Self {
        FastHasher { state: fast_mix(self.state, value) }
    }
    fn write_u32(self: Self, value: u32) -> Self { self.write_u64(value as u64) }
    fn write_u16(self: Self, value: u16) -> Self { self.write_u64(value as u64) }
    fn write_u8(self: Self, value: u8) -> Self { self.write_u64(value as u64) }
    fn write_i64(self: Self, value: i64) -> Self { self.write_u64(value as u64) }
    fn write_i32(self: Self, value: i32) -> Self {
        let bits = value as u32;
        self.write_u64(bits as u64)
    }
    fn write_i16(self: Self, value: i16) -> Self {
        let bits = value as u16;
        self.write_u64(bits as u64)
    }
    fn write_i8(self: Self, value: i8) -> Self {
        let bits = value as u8;
        self.write_u64(bits as u64)
    }
    fn write_bool(self: Self, value: bool) -> Self {
        self.write_u64(if value { 1 } else { 0 })
    }
    fn write_char(self: Self, value: char) -> Self {
        self.write_u64(char_code(value) as u64)
    }
    fn write_str(self: Self, value: str) -> Self {
        FastHasher { state: fx_write_str(self.state, value) }
    }
    fn write<T: Hash>(self: Self, value: T) -> Self { value.hash(self) }
    fn finish(self: Self) -> u64 { self.state }
    fn default() -> Self { FastHasher { state: 0 } }
    fn from_entropy(entropy: u64) -> Self { FastHasher { state: entropy } }
}

/// Creates a `FastHasher` with the default (zero) state.
pub fn fast_hasher() -> FastHasher {
    FastHasher { state: 0 }
}

/// Creates a `FastHasher` seeded with an explicit initial state.
pub fn fast_hasher_seeded(seed: u64) -> FastHasher {
    FastHasher { state: seed }
}

/// The Fx digest of any hashable value.
pub fn fast_hash<T: Hash>(value: T) -> u64 {
    value.hash(fast_hasher()).finish()
}

// -------------------------------------------------------------- StrongHasher

/// A full 64×64→128 product, computed from 32-bit limbs — the language
/// has no widening multiply, so the cross terms are assembled by hand.
/// The limb sums cannot overflow: each is bounded by (2^32 − 1)² plus
/// two 32-bit carries, which fits u64 exactly.
struct [value] Wide { lo : u64, hi : u64 }

fn mul_wide(a : u64, b : u64) -> Wide {
    let a_lo = a & 4294967295;
    let a_hi = a >> 32;
    let b_lo = b & 4294967295;
    let b_hi = b >> 32;
    let ll = a_lo * b_lo;
    let hl = a_hi * b_lo;
    let lh = a_lo * b_hi;
    let hh = a_hi * b_hi;
    let cross = (ll >> 32) + (hl & 4294967295) + lh;
    Wide {
        lo: (ll & 4294967295) | (cross << 32),
        hi: hh + (hl >> 32) + (cross >> 32)
    }
}

fn folded_multiply(a : u64, b : u64) -> u64 {
    let product = mul_wide(a, b);
    product.lo ^ product.hi
}

fn rotate_left(value : u64, shift : u64) -> u64 {
    let amount = shift & 63;
    if amount == 0 {
        value
    } else {
        (value << amount) | (value >> (64 - amount))
    }
}

/// A portable hash state derived from aHash's generic path. Reussir
/// writes fixed-size scalar values, so it uses aHash's specialized
/// single-word `update` instead of the byte-buffer path.
pub struct [value] StrongHasher {
    buffer : u64,
    pad : u64,
    key0 : u64,
    key1 : u64
}

impl StrongHasher {
    /// aHash's single-word fast path, used by every fixed-size write.
    fn update(self: Self, value : u64) -> Self {
        StrongHasher {
            buffer: folded_multiply(value ^ self.buffer, 6364136223846793005),
            pad: self.pad,
            key0: self.key0,
            key1: self.key1
        }
    }

    /// The two-word path used by the seed mixer. The generic byte-buffer
    /// path uses the same operation after loading a pair.
    fn large_update(self: Self, low : u64, high : u64) -> Self {
        let combined = folded_multiply(low ^ self.key0, high ^ self.key1);
        StrongHasher {
            buffer: rotate_left((self.buffer + self.pad) ^ combined, 23),
            pad: self.pad,
            key0: self.key0,
            key1: self.key1
        }
    }

    fn digest(self: Self) -> u64 {
        rotate_left(folded_multiply(self.buffer, self.pad), self.buffer & 63)
    }
}

// HashState::mix starts from the first aHash randomness row, absorbs the
// seed through the two-word update, and finalizes that state.
fn strong_mix_seed(seed : u64) -> u64 {
    StrongHasher {
        buffer: 2611923443488327891,  // 0x243f6a8885a308d3
        pad: 1376283091369227076,     // 0x13198a2e03707344
        key0: 11820040416388919760,  // 0xa4093822299f31d0
        key1: 589684135938649225      // 0x082efa98ec4e6c89
    }.large_update(seed, 0).digest()
}

fn strong_from_seed(seed : u64) -> StrongHasher {
    let mixed = strong_mix_seed(seed);
    StrongHasher {
        buffer: 4983270260364809079 ^ mixed,  // 0x452821e638d01377
        pad: 13714699805381954668 ^ mixed,    // 0xbe5466cf34e90c6c
        key0: 13883517620612518109 ^ mixed,   // 0xc0ac29b7c97c50dd
        key1: 4577018097722394903 ^ mixed     // 0x3f84d5b5b5470917
    }
}

impl Hasher for StrongHasher {
    fn write_u64(self: Self, value: u64) -> Self {
        self.update(value)
    }
    fn write_u32(self: Self, value: u32) -> Self { self.write_u64(value as u64) }
    fn write_u16(self: Self, value: u16) -> Self { self.write_u64(value as u64) }
    fn write_u8(self: Self, value: u8) -> Self { self.write_u64(value as u64) }
    fn write_i64(self: Self, value: i64) -> Self { self.write_u64(value as u64) }
    fn write_i32(self: Self, value: i32) -> Self {
        let bits = value as u32;
        self.write_u64(bits as u64)
    }
    fn write_i16(self: Self, value: i16) -> Self {
        let bits = value as u16;
        self.write_u64(bits as u64)
    }
    fn write_i8(self: Self, value: i8) -> Self {
        let bits = value as u8;
        self.write_u64(bits as u64)
    }
    fn write_bool(self: Self, value: bool) -> Self {
        self.write_u64(if value { 1 } else { 0 })
    }
    fn write_char(self: Self, value: char) -> Self {
        self.write_u64(char_code(value) as u64)
    }
    fn write_str(self: Self, value: str) -> Self {
        StrongHasher {
            buffer: strong_write_str(self.buffer, self.pad, self.key0, self.key1, value),
            pad: self.pad,
            key0: self.key0,
            key1: self.key1
        }
    }
    fn write<T: Hash>(self: Self, value: T) -> Self { value.hash(self) }
    fn finish(self: Self) -> u64 { self.digest() }
    fn default() -> Self { strong_from_seed(0) }
    fn from_entropy(entropy: u64) -> Self { strong_from_seed(entropy) }
}

/// Creates a `StrongHasher` with the default zero seed.
pub fn strong_hasher() -> StrongHasher {
    strong_from_seed(0)
}

/// Creates a `StrongHasher` seeded from caller entropy.
pub fn strong_hasher_seeded(seed: u64) -> StrongHasher {
    strong_from_seed(seed)
}

/// The strong digest of any hashable value.
pub fn strong_hash<T: Hash>(value: T) -> u64 {
    value.hash(strong_hasher()).finish()
}
