import std::collections::cow::binaryheap::BinaryHeap;
import std::collections::cow::btreemap::BTreeMap;
import std::collections::cow::btreeset::BTreeSet;
import std::option::Option;

fn wb(value : bool) {
    test_utils::io::write_i32(if value { 1 } else { 0 })
}

// A shared record key ordered by `id` through the compiler-emitted `Ord`
// bridge, as in ffi_btree_set_record_e2e.rr.
pub struct Key { id : i64 }

impl PartialEq for Key {
    fn eq(self : Self, other : Self) -> bool { self.id == other.id }
}

impl Eq for Key {}

impl PartialOrd for Key {
    fn lt(self : Self, other : Self) -> bool { self.id < other.id }
    fn le(self : Self, other : Self) -> bool { self.id <= other.id }
    fn gt(self : Self, other : Self) -> bool { self.id > other.id }
    fn ge(self : Self, other : Self) -> bool { self.id >= other.id }
}

impl Ord for Key {
    fn cmp(self : Self, other : Self) -> Ordering {
        if self.id < other.id {
            Ordering::Less
        } else {
            if self.id == other.id {
                Ordering::Equal
            } else {
                Ordering::Greater
            }
        }
    }
}

fn key(id : i64) -> Key {
    Key { id }
}

fn value_or(map : BTreeMap<Key, i64>, id : i64, fallback : i64) -> i64 {
    map.get(key(id)).unwrap_or(fallback)
}

fn key_or(value : Option<Key>, fallback : i64) -> i64 {
    match value {
        Option::Some(k) => k.id,
        Option::None => fallback
    }
}

fn test_map_basics() {
    let empty : BTreeMap<Key, i64> = BTreeMap::new();
    let base : BTreeMap<Key, i64> = BTreeMap::new();
    let map = base.insert(key(2), 20).insert(key(1), 10).insert(key(4), 40);
    let replaced = map.insert(key(2), 21);
    let removed = replaced.remove(key(1)).remove(key(9));
    let single : BTreeMap<Key, i64> = BTreeMap::singleton(key(3), 33);
    wb(empty.is_empty());
    wb(empty.first_key().is_none());
    wb(map.len() == 3);
    wb(value_or(map, 2, 0 - 1) == 20);
    wb(value_or(map, 7, 0 - 1) == 0 - 1);
    wb(map.contains_key(key(4)));
    wb(!map.contains_key(key(7)));
    wb(key_or(map.first_key(), 0 - 1) == 1);
    wb(key_or(map.last_key(), 0 - 1) == 4);
    wb(replaced.len() == 3);
    wb(value_or(replaced, 2, 0 - 1) == 21);
    wb(removed.len() == 2);
    wb(value_or(removed, 1, 0 - 1) == 0 - 1);
    wb(key_or(removed.first_key(), 0 - 1) == 2);
    wb(removed.clear().is_empty());
    wb(single.len() == 1);
}

fn test_map_cow() {
    let base : BTreeMap<Key, i64> = BTreeMap::new();
    let old = base.insert(key(1), 10).insert(key(2), 20);
    // `old` stays live below, so deriving `changed` shares the runtime
    // tree; the first update clones it — and the bridged keys — leaving
    // the retained version untouched.
    let changed = old.insert(key(3), 30).remove(key(1));
    wb(old.len() == 2);
    wb(value_or(old, 1, 0 - 1) == 10);
    wb(value_or(old, 3, 0 - 1) == 0 - 1);
    wb(changed.len() == 2);
    wb(value_or(changed, 1, 0 - 1) == 0 - 1);
    wb(value_or(changed, 3, 0 - 1) == 30);
}

fn test_set_basics() {
    let empty : BTreeSet<Key> = BTreeSet::new();
    let base : BTreeSet<Key> = BTreeSet::new();
    let set = base.insert(key(2)).insert(key(1)).insert(key(2)).insert(key(4));
    let removed = set.remove(key(2)).remove(key(9));
    wb(empty.is_empty());
    wb(empty.first().is_none());
    wb(set.len() == 3);
    wb(set.contains(key(2)));
    wb(!set.contains(key(7)));
    wb(key_or(set.first(), 0 - 1) == 1);
    wb(key_or(set.last(), 0 - 1) == 4);
    wb(removed.len() == 2);
    wb(!removed.contains(key(2)));
    wb(removed.clear().is_empty());
    wb(BTreeSet::singleton(key(6)).len() == 1);
    wb(set.len() == 3);
}

fn test_set_cow() {
    let base : BTreeSet<Key> = BTreeSet::new();
    let old = base.insert(key(1)).insert(key(2));
    let changed = old.insert(key(3)).remove(key(1));
    wb(old.len() == 2);
    wb(old.contains(key(1)));
    wb(!old.contains(key(3)));
    wb(changed.len() == 2);
    wb(!changed.contains(key(1)));
    wb(changed.contains(key(3)));
}

fn test_heap_basics() {
    let empty : BinaryHeap<Key> = BinaryHeap::new();
    let base : BinaryHeap<Key> = BinaryHeap::new();
    let heap = base.push(key(2)).push(key(5)).push(key(1)).push(key(5));
    let once = heap.pop();
    let thrice = once.pop().pop();
    let drained = thrice.pop().pop();
    wb(empty.is_empty());
    wb(empty.peek().is_none());
    // A max-heap: the greatest element surfaces, duplicates included.
    wb(heap.len() == 4);
    wb(key_or(heap.peek(), 0 - 1) == 5);
    wb(key_or(once.peek(), 0 - 1) == 5);
    wb(key_or(thrice.peek(), 0 - 1) == 1);
    // The pop past empty is a no-op.
    wb(drained.is_empty());
    wb(heap.clear().is_empty());
    wb(BinaryHeap::singleton(key(9)).len() == 1);
    wb(heap.len() == 4);
}

fn test_heap_cow() {
    let base : BinaryHeap<Key> = BinaryHeap::new();
    let old = base.push(key(1)).push(key(3));
    let changed = old.pop().push(key(7));
    wb(old.len() == 2);
    wb(key_or(old.peek(), 0 - 1) == 3);
    wb(changed.len() == 2);
    wb(key_or(changed.peek(), 0 - 1) == 7);
}

fn test_primitive_keys() {
    // Primitive keys and elements order through core's comparison tower;
    // scalars cross the boundary directly, with no bridge wrapper.
    let mbase : BTreeMap<i64, i64> = BTreeMap::new();
    let map = mbase.insert(2, 20).insert(1, 10).insert(2, 21);
    let sbase : BTreeSet<u64> = BTreeSet::new();
    let set = sbase.insert(7).insert(7).insert(9);
    let hbase : BinaryHeap<i64> = BinaryHeap::new();
    let heap = hbase.push(4).push(6).push(5);
    wb(map.len() == 2);
    wb(map.get(2).unwrap_or(0 - 1) == 21);
    wb(map.first_key().unwrap_or(0 - 1) == 1);
    wb(map.last_key().unwrap_or(0 - 1) == 2);
    wb(set.len() == 2);
    wb(set.contains(7));
    wb(!set.contains(8));
    wb(set.first().unwrap_or(0) == 7);
    wb(heap.peek().unwrap_or(0 - 1) == 6);
    wb(heap.pop().peek().unwrap_or(0 - 1) == 5);
}

fn str_key_or(value : Option<str>, fallback : str) -> str {
    match value {
        Option::Some(s) => s,
        Option::None => fallback
    }
}

fn test_str_keys() {
    // String-literal keys order through the runtime `Str`'s byte-wise
    // `Ord` — the same lexicographic semantics as Reussir's own
    // `str.compare`.
    let mbase : BTreeMap<str, i64> = BTreeMap::new();
    let map = mbase.insert("banana", 2).insert("apple", 1);
    let hbase : BinaryHeap<str> = BinaryHeap::new();
    let heap = hbase.push("apple").push("cherry").push("banana");
    wb(map.len() == 2);
    wb(map.get("apple").unwrap_or(0 - 1) == 1);
    wb(str_key_or(map.first_key(), "?") == "apple");
    wb(str_key_or(map.last_key(), "?") == "banana");
    wb(str_key_or(heap.peek(), "?") == "cherry");
}

#[main]
pub fn entry() {
    match test_utils::io::read_i32() {
        0 => test_map_basics(),
        1 => test_map_cow(),
        2 => test_set_basics(),
        3 => test_set_cow(),
        4 => test_heap_basics(),
        5 => test_heap_cow(),
        6 => test_primitive_keys(),
        7 => test_str_keys(),
        _ => core::intrinsic::panic::panic()
    }
}
