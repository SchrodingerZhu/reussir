// The copy-on-write ordered containers, backed by Rust's BTreeMap,
// BTreeSet, and BinaryHeap through the polymorphic FFI. Cases cover the
// core API with the `Ord` bridge on a shared record key, copy-on-write
// isolation of retained versions, max-heap ordering, and primitive keys
// through core's comparison tower.

// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}cow_ordered

// RUN: %std_rene_build/release/cow_ordered%exe_ext < %S/Inputs/cow_ordered/map_basics.in | %FileCheck %s --check-prefix=MAPBASICS
// MAPBASICS: 1

// RUN: %std_rene_build/release/cow_ordered%exe_ext < %S/Inputs/cow_ordered/map_cow.in | %FileCheck %s --check-prefix=MAPCOW
// MAPCOW: 1

// RUN: %std_rene_build/release/cow_ordered%exe_ext < %S/Inputs/cow_ordered/set_basics.in | %FileCheck %s --check-prefix=SETBASICS
// SETBASICS: 1

// RUN: %std_rene_build/release/cow_ordered%exe_ext < %S/Inputs/cow_ordered/set_cow.in | %FileCheck %s --check-prefix=SETCOW
// SETCOW: 1

// RUN: %std_rene_build/release/cow_ordered%exe_ext < %S/Inputs/cow_ordered/heap_basics.in | %FileCheck %s --check-prefix=HEAPBASICS
// HEAPBASICS: 1

// RUN: %std_rene_build/release/cow_ordered%exe_ext < %S/Inputs/cow_ordered/heap_cow.in | %FileCheck %s --check-prefix=HEAPCOW
// HEAPCOW: 1

// RUN: %std_rene_build/release/cow_ordered%exe_ext < %S/Inputs/cow_ordered/primitive_keys.in | %FileCheck %s --check-prefix=PRIMITIVEKEYS
// PRIMITIVEKEYS: 1

import std::collections::cow::binaryheap::BinaryHeap;
import std::collections::cow::btreemap::BTreeMap;
import std::collections::cow::btreeset::BTreeSet;
import std::option::Option;

fn wb(value : bool) {
    test_utils::io::write_i32(if value { 1 } else { 0 })
}

// A shared record key ordered by `id` through the compiler-emitted `Ord`
// bridge, as in ffi_btree_set_record_e2e.rr.
pub struct Key { id : i64 }

impl PartialEq for Key {
    fn eq(self : Self, other : Self) -> bool { self.id == other.id }
}

impl Eq for Key {}

impl PartialOrd for Key {
    fn lt(self : Self, other : Self) -> bool { self.id < other.id }
    fn le(self : Self, other : Self) -> bool { self.id <= other.id }
    fn gt(self : Self, other : Self) -> bool { self.id > other.id }
    fn ge(self : Self, other : Self) -> bool { self.id >= other.id }
}

impl Ord for Key {
    fn cmp(self : Self, other : Self) -> Ordering {
        if self.id < other.id {
            Ordering::Less
        } else {
            if self.id == other.id {
                Ordering::Equal
            } else {
                Ordering::Greater
            }
        }
    }
}

fn key(id : i64) -> Key {
    Key { id }
}

fn value_or(map : BTreeMap<Key, i64>, id : i64, fallback : i64) -> i64 {
    map.get(key(id)).unwrap_or(fallback)
}

fn key_or(value : Option<Key>, fallback : i64) -> i64 {
    match value {
        Option::Some(k) => k.id,
        Option::None => fallback
    }
}

fn test_map_basics() {
    let empty : BTreeMap<Key, i64> = BTreeMap::new();
    let base : BTreeMap<Key, i64> = BTreeMap::new();
    let map = base.insert(key(2), 20).insert(key(1), 10).insert(key(4), 40);
    let replaced = map.insert(key(2), 21);
    let removed = replaced.remove(key(1)).remove(key(9));
    let single : BTreeMap<Key, i64> = BTreeMap::singleton(key(3), 33);
    wb(empty.is_empty()
        && empty.first_key().is_none()
        && map.len() == 3
        && value_or(map, 2, 0 - 1) == 20
        && value_or(map, 7, 0 - 1) == 0 - 1
        && map.contains_key(key(4))
        && !map.contains_key(key(7))
        && key_or(map.first_key(), 0 - 1) == 1
        && key_or(map.last_key(), 0 - 1) == 4
        && replaced.len() == 3
        && value_or(replaced, 2, 0 - 1) == 21
        && removed.len() == 2
        && value_or(removed, 1, 0 - 1) == 0 - 1
        && key_or(removed.first_key(), 0 - 1) == 2
        && removed.clear().is_empty()
        && single.len() == 1);
}

fn test_map_cow() {
    let base : BTreeMap<Key, i64> = BTreeMap::new();
    let old = base.insert(key(1), 10).insert(key(2), 20);
    // `old` stays live below, so deriving `changed` shares the runtime
    // tree; the first update clones it — and the bridged keys — leaving
    // the retained version untouched.
    let changed = old.insert(key(3), 30).remove(key(1));
    wb(old.len() == 2
        && value_or(old, 1, 0 - 1) == 10
        && value_or(old, 3, 0 - 1) == 0 - 1
        && changed.len() == 2
        && value_or(changed, 1, 0 - 1) == 0 - 1
        && value_or(changed, 3, 0 - 1) == 30);
}

fn test_set_basics() {
    let empty : BTreeSet<Key> = BTreeSet::new();
    let base : BTreeSet<Key> = BTreeSet::new();
    let set = base.insert(key(2)).insert(key(1)).insert(key(2)).insert(key(4));
    let removed = set.remove(key(2)).remove(key(9));
    wb(empty.is_empty()
        && empty.first().is_none()
        && set.len() == 3
        && set.contains(key(2))
        && !set.contains(key(7))
        && key_or(set.first(), 0 - 1) == 1
        && key_or(set.last(), 0 - 1) == 4
        && removed.len() == 2
        && !removed.contains(key(2))
        && removed.clear().is_empty()
        && BTreeSet::singleton(key(6)).len() == 1);
}

fn test_set_cow() {
    let base : BTreeSet<Key> = BTreeSet::new();
    let old = base.insert(key(1)).insert(key(2));
    let changed = old.insert(key(3)).remove(key(1));
    wb(old.len() == 2
        && old.contains(key(1))
        && !old.contains(key(3))
        && changed.len() == 2
        && !changed.contains(key(1))
        && changed.contains(key(3)));
}

fn test_heap_basics() {
    let empty : BinaryHeap<Key> = BinaryHeap::new();
    let base : BinaryHeap<Key> = BinaryHeap::new();
    let heap = base.push(key(2)).push(key(5)).push(key(1)).push(key(5));
    let once = heap.pop();
    let thrice = once.pop().pop();
    let drained = thrice.pop().pop();
    wb(empty.is_empty()
        && empty.peek().is_none()
        // A max-heap: the greatest element surfaces, duplicates included.
        && heap.len() == 4
        && key_or(heap.peek(), 0 - 1) == 5
        && key_or(once.peek(), 0 - 1) == 5
        && key_or(thrice.peek(), 0 - 1) == 1
        // The pop past empty is a no-op.
        && drained.is_empty()
        && heap.clear().is_empty()
        && BinaryHeap::singleton(key(9)).len() == 1);
}

fn test_heap_cow() {
    let base : BinaryHeap<Key> = BinaryHeap::new();
    let old = base.push(key(1)).push(key(3));
    let changed = old.pop().push(key(7));
    wb(old.len() == 2
        && key_or(old.peek(), 0 - 1) == 3
        && changed.len() == 2
        && key_or(changed.peek(), 0 - 1) == 7);
}

fn test_primitive_keys() {
    // Primitive keys and elements order through core's comparison tower;
    // scalars cross the boundary directly, with no bridge wrapper.
    let mbase : BTreeMap<i64, i64> = BTreeMap::new();
    let map = mbase.insert(2, 20).insert(1, 10).insert(2, 21);
    let sbase : BTreeSet<u64> = BTreeSet::new();
    let set = sbase.insert(7).insert(7).insert(9);
    let hbase : BinaryHeap<i64> = BinaryHeap::new();
    let heap = hbase.push(4).push(6).push(5);
    wb(map.len() == 2
        && map.get(2).unwrap_or(0 - 1) == 21
        && map.first_key().unwrap_or(0 - 1) == 1
        && map.last_key().unwrap_or(0 - 1) == 2
        && set.len() == 2
        && set.contains(7)
        && !set.contains(8)
        && set.first().unwrap_or(0) == 7
        && heap.peek().unwrap_or(0 - 1) == 6
        && heap.pop().peek().unwrap_or(0 - 1) == 5);
}

#[main]
pub fn entry() {
    match test_utils::io::read_i32() {
        0 => test_map_basics(),
        1 => test_map_cow(),
        2 => test_set_basics(),
        3 => test_set_cow(),
        4 => test_heap_basics(),
        5 => test_heap_cow(),
        6 => test_primitive_keys(),
        _ => core::intrinsic::panic::panic()
    }
}
