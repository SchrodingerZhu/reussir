// Each input selects one persistent List unit case through the executable's
// dispatcher. New methods can be covered without changing existing cases.

// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %T/rene-build --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}list

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/len.in | %FileCheck %s --check-prefix=LEN
// LEN:      1
// LEN-NEXT: 1

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/head.in | %FileCheck %s --check-prefix=HEAD
// HEAD:      3
// HEAD-NEXT: -1

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/tail.in | %FileCheck %s --check-prefix=TAIL
// TAIL:      1
// TAIL-NEXT: 1

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/is_nil.in | %FileCheck %s --check-prefix=IS-NIL
// IS-NIL:      1
// IS-NIL-NEXT: 0

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/is_cons.in | %FileCheck %s --check-prefix=IS-CONS
// IS-CONS:      0
// IS-CONS-NEXT: 1

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/reverse.in | %FileCheck %s --check-prefix=REVERSE
// REVERSE:      2
// REVERSE-NEXT: 1
// REVERSE-NEXT: 3

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/map.in | %FileCheck %s --check-prefix=MAP
// MAP:      4
// MAP-NEXT: 2
// MAP-NEXT: 3

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/min.in | %FileCheck %s --check-prefix=MIN
// MIN:      1
// MIN-NEXT: -1

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/max.in | %FileCheck %s --check-prefix=MAX
// MAX:      3
// MAX-NEXT: 2
// MAX-NEXT: -1

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/contains.in | %FileCheck %s --check-prefix=CONTAINS
// CONTAINS:      1
// CONTAINS-NEXT: 0
// CONTAINS-NEXT: 0

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/fold_left.in | %FileCheck %s --check-prefix=FOLD-LEFT
// FOLD-LEFT:      312
// FOLD-LEFT-NEXT: 7

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/count_if.in | %FileCheck %s --check-prefix=COUNT-IF
// COUNT-IF:      1
// COUNT-IF-NEXT: 1

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/find_first.in | %FileCheck %s --check-prefix=FIND-FIRST
// FIND-FIRST:      1
// FIND-FIRST-NEXT: -1

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/filter.in | %FileCheck %s --check-prefix=FILTER
// FILTER:      3
// FILTER-NEXT: 1
// FILTER-NEXT: 1
// FILTER-NEXT: 1

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/any.in | %FileCheck %s --check-prefix=ANY
// ANY:      1
// ANY-NEXT: 0
// ANY-NEXT: 0

// RUN: %T/rene-build/release/list%exe_ext < %S/Inputs/list/all.in | %FileCheck %s --check-prefix=ALL
// ALL:      1
// ALL-NEXT: 0
// ALL-NEXT: 1

import std::collections::pure::list::List;

fn sample_list() -> List<i32> {
    List::Cons {
        3,
        List::Cons { 1, List::Cons { 2, List::Nil } }
    }
}

fn empty_list() -> List<i32> {
    List::Nil
}

fn write_bool(value: bool) {
    test_utils::io::write_i32(if value { 1 } else { 0 })
}

fn test_len() {
    write_bool(empty_list().len() == 0);
    write_bool(sample_list().len() == 3);
}

fn test_head() {
    test_utils::io::write_i32(sample_list().head().unwrap_or(-1));
    test_utils::io::write_i32(empty_list().head().unwrap_or(-1));
}

fn test_tail() {
    test_utils::io::write_i32(sample_list().tail().head().unwrap_or(-1));
    write_bool(empty_list().tail().is_nil());
}

fn test_is_nil() {
    write_bool(empty_list().is_nil());
    write_bool(sample_list().is_nil());
}

fn test_is_cons() {
    write_bool(empty_list().is_cons());
    write_bool(sample_list().is_cons());
}

fn test_reverse() {
    test_utils::io::write_i32(sample_list().reverse().head().unwrap_or(-1));
    test_utils::io::write_i32(
        sample_list().reverse().tail().head().unwrap_or(-1)
    );
    test_utils::io::write_i32(
        sample_list().reverse().tail().tail().head().unwrap_or(-1)
    );
}

fn test_map() {
    let increment = |x: i32| x + 1;
    test_utils::io::write_i32(sample_list().map(increment).head().unwrap_or(-1));
    test_utils::io::write_i32(
        sample_list().map(increment).tail().head().unwrap_or(-1)
    );
    test_utils::io::write_i32(
        sample_list().map(increment).tail().tail().head().unwrap_or(-1)
    );
}

fn test_min() {
    test_utils::io::write_i32(sample_list().min().unwrap_or(-1));
    test_utils::io::write_i32(empty_list().min().unwrap_or(-1));
}

fn test_max() {
    test_utils::io::write_i32(sample_list().max().unwrap_or(-1));
    test_utils::io::write_i32(sample_list().tail().max().unwrap_or(-1));
    test_utils::io::write_i32(empty_list().max().unwrap_or(-1));
}

fn test_contains() {
    write_bool(sample_list().contains(1));
    write_bool(sample_list().contains(9));
    write_bool(empty_list().contains(1));
}

fn test_fold_left() {
    test_utils::io::write_i32(
        sample_list().fold_left(0, |acc: i32, x: i32| acc * 10 + x)
    );
    test_utils::io::write_i32(
        empty_list().fold_left(7, |acc: i32, x: i32| acc + x)
    );
}

fn test_count_if() {
    write_bool(sample_list().count_if(|x: i32| x >= 2) == 2);
    write_bool(empty_list().count_if(|x: i32| x >= 2) == 0);
}

fn test_find_first() {
    test_utils::io::write_i32(
        sample_list().find_first(|x: i32| x < 3).unwrap_or(-1)
    );
    test_utils::io::write_i32(
        sample_list().find_first(|x: i32| x > 3).unwrap_or(-1)
    );
}

fn test_filter() {
    let filtered = sample_list().filter(|x: i32| x % 2 != 0);
    test_utils::io::write_i32(filtered.head().unwrap_or(-1));
    test_utils::io::write_i32(filtered.tail().head().unwrap_or(-1));
    write_bool(filtered.tail().tail().is_nil());
    write_bool(empty_list().filter(|x: i32| x > 0).is_nil());
}

fn test_any() {
    write_bool(sample_list().any(|x: i32| x < 2));
    write_bool(sample_list().any(|x: i32| x > 3));
    write_bool(empty_list().any(|x: i32| x > 0));
}

fn test_all() {
    write_bool(sample_list().all(|x: i32| x > 0));
    write_bool(sample_list().all(|x: i32| x < 3));
    write_bool(empty_list().all(|x: i32| x > 0));
}

#[main]
pub fn entry() {
    match test_utils::io::read_i32() {
        0 => test_len(),
        1 => test_head(),
        2 => test_tail(),
        3 => test_is_nil(),
        4 => test_is_cons(),
        5 => test_reverse(),
        6 => test_map(),
        7 => test_min(),
        8 => test_max(),
        9 => test_contains(),
        10 => test_fold_left(),
        11 => test_count_if(),
        12 => test_find_first(),
        13 => test_filter(),
        14 => test_any(),
        15 => test_all(),
        _ => core::intrinsic::panic::panic()
    }
}
