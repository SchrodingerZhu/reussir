// A downstream package instantiates every generic finger-tree operation.
// Numeric cases cover both ends, cached measures, random access, splitting,
// concatenation, editing, traversal, persistence, and shared payloads.

// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}fingertree

// RUN: %std_rene_build/release/fingertree%exe_ext < %S/Inputs/fingertree/new.in | %FileCheck %s --check-prefix=NEW
// NEW:      1
// NEW-NEXT: 1
// NEW-NEXT: 1
// NEW-NEXT: 1
// NEW-NEXT: 1
// NEW-NEXT: 1

