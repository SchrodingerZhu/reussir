// A downstream package instantiates both persistent priority queues.
// Cases cover the public API, persistence of shared versions, heapsort
// output order, a model-checked insert/delete-min churn, agreement
// between the two implementations on identical inputs, clear, and the
// valid() invariant checkers across every construction path.

// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}heap

// RUN: %std_rene_build/release/heap%exe_ext < %S/Inputs/heap/pairing_basics.in | %FileCheck %s --check-prefix=PAIRING
// PAIRING:      1
// PAIRING-NEXT: 1
// PAIRING-NEXT: 1
// PAIRING-NEXT: 1
// PAIRING-NEXT: 1
// PAIRING-NEXT: 1
// PAIRING-NEXT: 1

// RUN: %std_rene_build/release/heap%exe_ext < %S/Inputs/heap/binomial_basics.in | %FileCheck %s --check-prefix=BINOMIAL
// BINOMIAL:      1
// BINOMIAL-NEXT: 1
// BINOMIAL-NEXT: 1
// BINOMIAL-NEXT: 1
// BINOMIAL-NEXT: 1
// BINOMIAL-NEXT: 1
// BINOMIAL-NEXT: 1

// RUN: %std_rene_build/release/heap%exe_ext < %S/Inputs/heap/pairing_sort.in | %FileCheck %s --check-prefix=PSORT
// PSORT:      1
// PSORT-NEXT: 1
// PSORT-NEXT: 1

// RUN: %std_rene_build/release/heap%exe_ext < %S/Inputs/heap/binomial_sort.in | %FileCheck %s --check-prefix=BSORT
// BSORT:      1
// BSORT-NEXT: 1
// BSORT-NEXT: 1

// RUN: %std_rene_build/release/heap%exe_ext < %S/Inputs/heap/churn.in | %FileCheck %s --check-prefix=CHURN
// CHURN:      1
// CHURN-NEXT: 1
// CHURN-NEXT: 1
// CHURN-NEXT: 1

// RUN: %std_rene_build/release/heap%exe_ext < %S/Inputs/heap/agreement.in | %FileCheck %s --check-prefix=AGREE
// AGREE:      1
// AGREE-NEXT: 1

// RUN: %std_rene_build/release/heap%exe_ext < %S/Inputs/heap/api_extras.in | %FileCheck %s --check-prefix=API
// API:      1
// API-NEXT: 1
// API-NEXT: 1
// API-NEXT: 1
// API-NEXT: 1

// RUN: %std_rene_build/release/heap%exe_ext < %S/Inputs/heap/invariants.in | %FileCheck %s --check-prefix=INV
// INV:      1
