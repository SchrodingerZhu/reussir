// The copy-on-write sequence containers, backed by Rust's Vec and
// VecDeque through the polymorphic FFI. Cases cover the core API with
// out-of-bounds and empty guards, copy-on-write isolation of a retained
// version, and shared-record elements cloned through their acquire glue.

// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}cow_seq

// RUN: %std_rene_build/release/cow_seq%exe_ext < %S/Inputs/cow_seq/vec_basics.in | %FileCheck %s --check-prefix=VECBASICS
// VECBASICS: 1

// RUN: %std_rene_build/release/cow_seq%exe_ext < %S/Inputs/cow_seq/vec_cow.in | %FileCheck %s --check-prefix=VECCOW
// VECCOW: 1

// RUN: %std_rene_build/release/cow_seq%exe_ext < %S/Inputs/cow_seq/deque_basics.in | %FileCheck %s --check-prefix=DEQUEBASICS
// DEQUEBASICS: 1

// RUN: %std_rene_build/release/cow_seq%exe_ext < %S/Inputs/cow_seq/deque_cow.in | %FileCheck %s --check-prefix=DEQUECOW
// DEQUECOW: 1

// RUN: %std_rene_build/release/cow_seq%exe_ext < %S/Inputs/cow_seq/record_elements.in | %FileCheck %s --check-prefix=RECORDELEMENTS
// RECORDELEMENTS: 1

import std::collections::cow::vec::Vec;
import std::collections::cow::vecdeque::VecDeque;
import std::option::Option;

fn wb(value : bool) {
    test_utils::io::write_i32(if value { 1 } else { 0 })
}

fn value_or(v : Vec<i64>, index : u64, fallback : i64) -> i64 {
    v.get(index).unwrap_or(fallback)
}

fn test_vec_basics() {
    let empty : Vec<i64> = Vec::new();
    let base : Vec<i64> = Vec::new();
    let v = base.push(10).push(20).push(30);
    let edited = v.set(1, 21).insert_at(1, 15).remove_at(0);
    let popped = edited.pop();
    let single : Vec<i64> = Vec::singleton(7);
    wb(empty.is_empty()
        && v.len() == 3
        && value_or(v, 0, 0 - 1) == 10
        && value_or(v, 2, 0 - 1) == 30
        && value_or(v, 3, 0 - 1) == 0 - 1
        && v.last().unwrap_or(0 - 1) == 30
        // set replaced index 1, insert_at shifted it right, remove_at
        // dropped the head: [15, 21, 30].
        && edited.len() == 3
        && value_or(edited, 0, 0 - 1) == 15
        && value_or(edited, 1, 0 - 1) == 21
        && value_or(edited, 2, 0 - 1) == 30
        && popped.len() == 2
        && popped.last().unwrap_or(0 - 1) == 21
        && popped.clear().is_empty()
        && single.len() == 1);
}

fn test_vec_cow() {
    let base : Vec<i64> = Vec::new();
    let old = base.push(1).push(2);
    // `old` stays live below, so deriving `changed` shares the runtime
    // buffer; the first update clones it and must leave the retained
    // version untouched.
    let changed = old.push(3).set(0, 9);
    wb(old.len() == 2
        && value_or(old, 0, 0 - 1) == 1
        && value_or(old, 2, 0 - 1) == 0 - 1
        && changed.len() == 3
        && value_or(changed, 0, 0 - 1) == 9
        && value_or(changed, 2, 0 - 1) == 3);
}

fn test_deque_basics() {
    let empty : VecDeque<i64> = VecDeque::new();
    let base : VecDeque<i64> = VecDeque::new();
    let d = base.push_back(2).push_back(3).push_front(1);
    let shrunk = d.pop_front().pop_back();
    let drained = shrunk.pop_front().pop_front();
    wb(empty.is_empty()
        && empty.front().is_none()
        && d.len() == 3
        && d.front().unwrap_or(0 - 1) == 1
        && d.back().unwrap_or(0 - 1) == 3
        && d.get(1).unwrap_or(0 - 1) == 2
        && d.get(9).is_none()
        && shrunk.len() == 1
        && shrunk.front().unwrap_or(0 - 1) == 2
        && shrunk.back().unwrap_or(0 - 1) == 2
        // The second pop on the emptied deque is a no-op.
        && drained.is_empty()
        && d.clear().is_empty());
}

fn test_deque_cow() {
    let base : VecDeque<i64> = VecDeque::new();
    let old = base.push_back(1).push_back(2);
    let changed = old.pop_front().push_back(3);
    wb(old.len() == 2
        && old.front().unwrap_or(0 - 1) == 1
        && changed.len() == 2
        && changed.front().unwrap_or(0 - 1) == 2
        && changed.back().unwrap_or(0 - 1) == 3);
}

pub struct Item { v : i64 }

fn item_or(value : Option<Item>, fallback : i64) -> i64 {
    match value {
        Option::Some(item) => item.v,
        Option::None => fallback
    }
}

fn test_record_elements() {
    // Shared records as elements: the copy-on-write clone runs their
    // acquire glue, and both versions keep independent entries.
    let base : Vec<Item> = Vec::new();
    let old = base.push(Item { v: 10 }).push(Item { v: 20 });
    let changed = old.set(0, Item { v: 11 });
    wb(item_or(old.get(0), 0 - 1) == 10
        && item_or(changed.get(0), 0 - 1) == 11
        && item_or(changed.get(1), 0 - 1) == 20);
}

#[main]
pub fn entry() {
    match test_utils::io::read_i32() {
        0 => test_vec_basics(),
        1 => test_vec_cow(),
        2 => test_deque_basics(),
        3 => test_deque_cow(),
        4 => test_record_elements(),
        _ => core::intrinsic::panic::panic()
    }
}
