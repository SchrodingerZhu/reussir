// Each input selects one Option unit case through the executable's dispatcher.
// Adding coverage only requires a test function, a match arm, and an input run.

// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}option

// RUN: %std_rene_build/release/option%exe_ext < %S/Inputs/option/is_some.in | %FileCheck %s --check-prefix=IS-SOME
// IS-SOME:      1
// IS-SOME-NEXT: 0

// RUN: %std_rene_build/release/option%exe_ext < %S/Inputs/option/is_none.in | %FileCheck %s --check-prefix=IS-NONE
// IS-NONE:      0
// IS-NONE-NEXT: 1

// RUN: %std_rene_build/release/option%exe_ext < %S/Inputs/option/and.in | %FileCheck %s --check-prefix=AND
// AND:      9
// AND-NEXT: -1

// RUN: %std_rene_build/release/option%exe_ext < %S/Inputs/option/or.in | %FileCheck %s --check-prefix=OR
// OR:      4
// OR-NEXT: 9

// RUN: %std_rene_build/release/option%exe_ext < %S/Inputs/option/map.in | %FileCheck %s --check-prefix=MAP
// MAP:      5
// MAP-NEXT: 9

// RUN: %std_rene_build/release/option%exe_ext < %S/Inputs/option/and_then.in | %FileCheck %s --check-prefix=AND-THEN
// AND-THEN:      8
// AND-THEN-NEXT: 9

// RUN: %std_rene_build/release/option%exe_ext < %S/Inputs/option/unwrap_or.in | %FileCheck %s --check-prefix=UNWRAP-OR
// UNWRAP-OR:      4
// UNWRAP-OR-NEXT: 9

// RUN: %std_rene_build/release/option%exe_ext < %S/Inputs/option/unwrap_or_panic.in | %FileCheck %s --check-prefix=UNWRAP-OR-PANIC
// UNWRAP-OR-PANIC: 4

import std::option::Option;

fn some(value: i32) -> Option<i32> {
    Option::Some { value }
}

fn none() -> Option<i32> {
    Option::None
}

fn write_bool(value: bool) {
    test_utils::io::write_i32(if value { 1 } else { 0 })
}

fn test_is_some() {
    write_bool(some(4).is_some());
    write_bool(none().is_some());
}

fn test_is_none() {
    write_bool(some(4).is_none());
    write_bool(none().is_none());
}

fn test_and() {
    test_utils::io::write_i32(some(4).and(some(9)).unwrap_or(-1));
    test_utils::io::write_i32(none().and(some(9)).unwrap_or(-1));
}

fn test_or() {
    test_utils::io::write_i32(some(4).or(some(9)).unwrap_or(-1));
    test_utils::io::write_i32(none().or(some(9)).unwrap_or(-1));
}

fn test_map() {
    test_utils::io::write_i32(some(4).map(|x: i32| x + 1).unwrap_or(9));
    test_utils::io::write_i32(none().map(|x: i32| x + 1).unwrap_or(9));
}

fn test_and_then() {
    test_utils::io::write_i32(
        some(4).and_then(|x: i32| some(x * 2)).unwrap_or(9)
    );
    test_utils::io::write_i32(
        none().and_then(|x: i32| some(x * 2)).unwrap_or(9)
    );
}

fn test_unwrap_or() {
    test_utils::io::write_i32(some(4).unwrap_or(9));
    test_utils::io::write_i32(none().unwrap_or(9));
}

fn test_unwrap_or_panic() {
    test_utils::io::write_i32(some(4).unwrap_or_panic());
}

#[main]
pub fn entry() {
    match test_utils::io::read_i32() {
        0 => test_is_some(),
        1 => test_is_none(),
        2 => test_and(),
        3 => test_or(),
        4 => test_map(),
        5 => test_and_then(),
        6 => test_unwrap_or(),
        7 => test_unwrap_or_panic(),
        _ => core::intrinsic::panic::panic()
    }
}
