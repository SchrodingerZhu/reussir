// std::hash end to end: user `Hash` impls (ground and generic)
// dispatching through the `Hasher` trait into the pure value hashers,
// the scalar write helpers and seeding.
//
// The VECTORS digests are pinned against the documented algorithms
// (classic Fx for FastHasher; an aHash-derived state with the
// primitive update specialization for StrongHasher), computed
// independently. They guard the chaining and state handling: any drift
// shows up as a changed number rather than as quietly different hashes.

// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}hash

// RUN: %std_rene_build/release/hash%exe_ext < %S/Inputs/hash/vectors.in | %FileCheck %s --check-prefix=VECTORS
// fast/strong over words 1 ++ 2
// VECTORS:      7659469028595837896
// VECTORS-NEXT: 14389719906271566111
// scalar u64 42, default seed
// VECTORS-NEXT: 6807129317463932018
// VECTORS-NEXT: 7367054577293084200
// scalar u64 42, seed 12345
// VECTORS-NEXT: 2483310807519886546
// VECTORS-NEXT: 15056869511168324300
// u32 7, u16 8, u8 9, bool true, char 'z'
// VECTORS-NEXT: 11710304454334885276
// VECTORS-NEXT: 16033770625569700645
// streaming u64 5 under seed 99
// VECTORS-NEXT: 18396363454642202825
// VECTORS-NEXT: 6887771581839605075

// RUN: %std_rene_build/release/hash%exe_ext < %S/Inputs/hash/properties.in | %FileCheck %s --check-prefix=PROPS
// PROPS:      1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// the associated constructors (default/from_entropy) agree with
// the free ones, through a generic consumer and type prefixes
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1

// Exercises std::hash end to end: user `Hash` impls dispatching through
// the `Hasher` trait into the pure value hashers, the scalar write
// helpers and seeding.
//
// The pinned digests are computed independently from the documented
// algorithms (classic Fx for FastHasher; an aHash-derived
// state and primitive update specialization for StrongHasher) — so a
// change in chaining or state handling shows up here as a changed number
// rather than as silently different hashes.

import std::hash::Hash;
import std::hash::Hasher;
import std::hash::FastHasher;
import std::hash::StrongHasher;

#[ffi(import)]
fn print_u64(value: u64) [{ println!("{value}") }];

fn wb(v : bool) { test_utils::io::write_i32(if v { 1 } else { 0 }) }

pub struct Point { pub x : i64, pub y : i64 }

impl Hash for Point {
    fn hash<H: Hasher>(self: Self, state: H) -> H {
        state.write_i64(self.x).write_i64(self.y)
    }
}

// A generic composite recursing through both bounds, so the impl is
// instantiated at the user's call shape rather than pre-monomorphized.
pub struct Pair<A, B> { pub a : A, pub b : B }

impl<A : Hash, B : Hash> Hash for Pair<A, B> {
    fn hash<H: Hasher>(self: Self, state: H) -> H {
        state.write(self.a).write(self.b)
    }
}

fn test_reference_vectors() {
    // Point { 1, 2 } is two u64 writes.
    print_u64(std::hash::fast_hash(Point { x: 1, y: 2 }));
    print_u64(std::hash::strong_hash(Point { x: 1, y: 2 }));
    // Single scalar, default seed.
    print_u64(std::hash::fast_hasher().write_u64(42).finish());
    print_u64(std::hash::strong_hasher().write_u64(42).finish());
    // Single scalar, explicit seed.
    print_u64(std::hash::fast_hasher_seeded(12345).write_u64(42).finish());
    print_u64(std::hash::strong_hasher_seeded(12345).write_u64(42).finish());
    // Mixed widths plus bool and char, through the streaming hasher.
    print_u64(std::hash::fast_hasher()
        .write_u32(7).write_u16(8).write_u8(9).write_bool(true).write_char('z')
        .finish());
    print_u64(std::hash::strong_hasher()
        .write_u32(7).write_u16(8).write_u8(9).write_bool(true).write_char('z')
        .finish());
    // Streaming with an explicit seed.
    print_u64(std::hash::fast_hasher_seeded(99).write_u64(5).finish());
    print_u64(std::hash::strong_hasher_seeded(99).write_u64(5).finish());
}

fn test_properties() {
    // Equal values hash equally; different ones differ.
    wb(std::hash::fast_hash(Point { x: 3, y: 4 }) ==
        std::hash::fast_hash(Point { x: 3, y: 4 }));
    wb(std::hash::fast_hash(Point { x: 3, y: 4 }) !=
        std::hash::fast_hash(Point { x: 4, y: 3 }));
    // The two variants are distinct functions.
    wb(std::hash::fast_hash(Point { x: 3, y: 4 }) !=
        std::hash::strong_hash(Point { x: 3, y: 4 }));
    // Seeding changes the digest, and the default seed round-trips.
    wb(std::hash::fast_hasher_seeded(1).write_u64(5).finish() !=
        std::hash::fast_hasher_seeded(2).write_u64(5).finish());
    // The generic impl composes: Pair folds one state through both fields.
    wb(std::hash::fast_hash(Pair {
        a: Point { x: 1, y: 2 },
        b: Point { x: 3, y: 4 }
    }) == std::hash::fast_hash(Pair {
        a: Point { x: 1, y: 2 },
        b: Point { x: 3, y: 4 }
    }));
    wb(std::hash::fast_hash(Pair {
        a: Point { x: 1, y: 2 },
        b: Point { x: 3, y: 4 }
    }) != std::hash::fast_hash(Pair {
        a: Point { x: 3, y: 4 },
        b: Point { x: 1, y: 2 }
    }));
    // Field order matters: writing x then y differs from y then x.
    wb(std::hash::fast_hasher().write_i64(1).write_i64(2).finish() !=
        std::hash::fast_hasher().write_i64(2).write_i64(1).finish());
    // Signed writes reinterpret, so -1i64 and u64::MAX agree.
    wb(std::hash::fast_hasher().write_i64(0 - 1).finish() ==
        std::hash::fast_hasher().write_u64(18446744073709551615).finish());
    // StrongHasher sends every fixed-size primitive through the same
    // zero-extending single-word update specialization.
    wb(std::hash::strong_hasher().write_u8(7).finish() ==
        std::hash::strong_hasher().write_u64(7).finish());
    wb(std::hash::strong_hasher().write_i32(0 - 1).finish() ==
        std::hash::strong_hasher().write_u32(4294967295).finish());
    // A hasher is a value: reusing an earlier state does not observe
    // writes made to a later one.
    let base = std::hash::fast_hasher().write_u64(1);
    let branch = base.write_u64(2).finish();
    wb(base.finish() == std::hash::fast_hasher().write_u64(1).finish());
    wb(branch != base.finish());
    // The associated constructors: a generic consumer builds its hasher
    // through the trait — the hash-container pattern — and the type-
    // prefixed forms agree with the free constructors.
    wb(digest_of<FastHasher, Point>(Point { x: 3, y: 4 }) ==
        std::hash::fast_hash(Point { x: 3, y: 4 }));
    wb(digest_of<StrongHasher, Point>(Point { x: 3, y: 4 }) ==
        std::hash::strong_hash(Point { x: 3, y: 4 }));
    wb(FastHasher::from_entropy(99).write_u64(5).finish() ==
        std::hash::fast_hasher_seeded(99).write_u64(5).finish());
    wb(StrongHasher::from_entropy(99).write_u64(5).finish() ==
        std::hash::strong_hasher_seeded(99).write_u64(5).finish());
    wb(FastHasher::from_entropy(99).write_u64(5).finish() !=
        FastHasher::default().write_u64(5).finish());
    let via_trait : FastHasher = Hasher::default();
    wb(via_trait.write_u64(1234).finish() ==
        std::hash::fast_hasher().write_u64(1234).finish());
}

// The hash-container construction pattern: the hasher type is a bound,
// and the consumer builds it with `H::default()`.
fn digest_of<H : Hasher, T : Hash>(value : T) -> u64 {
    value.hash(H::default()).finish()
}

#[main]
pub fn main() {
    let case = test_utils::io::read_i32();
    if case == 1 { test_reference_vectors() } else { test_properties() }
}
