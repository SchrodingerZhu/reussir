// RUN: %not %rrc %s --emit hir -o - 2>&1 | %FileCheck %s
enum Foo {
    Bar(Foo),
    Baz,
    Qux(Foo, Foo)
}

fn foo(x : Foo, flag: bool) -> Foo {
    match x {
        Foo::Qux(y, Foo::Qux(_, _)) => y,
        _ if flag => x,
        Foo::Qux(Foo::Qux(_, _), z) => z,
        Foo::Bar(y) => foo(y, flag),
        Foo::Baz => Foo::Baz{}
    }
}

// The diagnostic is rendered with a source caret pointing at the `match`.
// CHECK: non-exhaustive patterns in `match`
// CHECK: meaningless_wrong.rr:9:5
