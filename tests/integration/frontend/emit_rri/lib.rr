// The interface fixture: a `pub` generic whose body reaches a private
// generic, a private ground over a private record, and a cross-module `pub`
// ground — plus a `pub` record surface and items nothing exports.

mod util;

pub struct Point {
    pub x: i64,
    y: i64,
}

struct Secret {
    v: i64,
}

fn hidden(s: Secret) -> i64 {
    s.v
}

fn baz(x: i64) -> i64 {
    x
}

fn bar(x: i64) -> i64 {
    baz(x)
}

fn scale_impl<T : Num>(x: T, k: i64) -> i64 {
    util::mul(k, hidden(Secret { v: 2 })) + bar(k)
}

pub fn scale<T : Num>(x: T) -> i64 {
    scale_impl(x, 3)
}

pub fn origin() -> Point {
    Point { x: 0, y: 0 }
}

fn never_exported(p: Point) -> i64 {
    p.x
}
