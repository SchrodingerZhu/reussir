// RUN: %rrc %s --emit hir -o - | %FileCheck %s
// RUN: %rrc %s --emit mir -o - | %FileCheck %s --check-prefix=FULL

fn classify(x : i32) -> i32 {
    match x {
        0 => 1,
        1 => 2,
        _ => 3
    }
}

// CHECK: fn #classify(v0 (x): i32) -> i32 {
// CHECK-NEXT:     match v0 : i32 {
// CHECK-NEXT:         switch scrut {
// CHECK-NEXT:             0 => {
// CHECK-NEXT:                 => 1 : i32
// CHECK-NEXT:             }
// CHECK-NEXT:             1 => {
// CHECK-NEXT:                 => 2 : i32
// CHECK-NEXT:             }
// CHECK-NEXT:             _ => {
// CHECK-NEXT:                 => 3 : i32
// CHECK-NEXT:             }
// CHECK-NEXT:         }
// CHECK-NEXT:     } : i32
// CHECK-NEXT: }

