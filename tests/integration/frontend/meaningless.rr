// RUN: %rrc %s --emit hir -o - | %FileCheck %s
// RUN: %rrc %s --emit mir -o - | %FileCheck %s --check-prefix=FULL

enum Foo {
    Bar(Foo),
    Baz,
    Qux(Foo, Foo)
}

fn foo(x : Foo, flag: bool) -> Foo {
    match x {
        Foo::Qux(y, Foo::Qux(_, _)) => y,
        _ if flag => x,
        Foo::Qux(_, Foo::Bar(z)) => z,
        Foo::Qux(y, Foo::Baz) => y,
        Foo::Bar(y) => foo(y, flag),
        Foo::Baz => Foo::Baz{}
    }
}

// CHECK: [shared] enum #Foo { Bar(#Foo), Baz(), Qux(#Foo, #Foo) };
// CHECK-EMPTY:
// CHECK-NEXT: fn #foo(v0 (x): #Foo, v1 (flag): bool) -> #Foo {
// CHECK-NEXT:     match v0 : #Foo {
// CHECK-NEXT:         switch scrut {
// CHECK-NEXT:             #0 => {
// CHECK-NEXT:                 if v1 : bool {
// CHECK-NEXT:                     => v0 : #Foo
// CHECK-NEXT:                 } else {
// CHECK-NEXT:                     v5=scrut.0 => #foo(v5 : #Foo, v1 : bool) : #Foo
// CHECK-NEXT:                 }
// CHECK-NEXT:             }
// CHECK-NEXT:             #1 => {
// CHECK-NEXT:                 if v1 : bool {
// CHECK-NEXT:                     => v0 : #Foo
// CHECK-NEXT:                 } else {
// CHECK-NEXT:                     => #Foo#1() : #Foo
// CHECK-NEXT:                 }
// CHECK-NEXT:             }
// CHECK-NEXT:             #2 => {
// CHECK-NEXT:                 switch scrut.1 {
// CHECK-NEXT:                     #0 => {
// CHECK-NEXT:                         if v1 : bool {
// CHECK-NEXT:                             => v0 : #Foo
// CHECK-NEXT:                         } else {
// CHECK-NEXT:                             v3=scrut.1.0 => v3 : #Foo
// CHECK-NEXT:                         }
// CHECK-NEXT:                     }
// CHECK-NEXT:                     #1 => {
// CHECK-NEXT:                         if v1 : bool {
// CHECK-NEXT:                             => v0 : #Foo
// CHECK-NEXT:                         } else {
// CHECK-NEXT:                             v4=scrut.0 => v4 : #Foo
// CHECK-NEXT:                         }
// CHECK-NEXT:                     }
// CHECK-NEXT:                     #2 => {
// CHECK-NEXT:                         v2=scrut.0 => v2 : #Foo
// CHECK-NEXT:                     }
// CHECK-NEXT:                 }
// CHECK-NEXT:             }
// CHECK-NEXT:         }
// CHECK-NEXT:     } : #Foo
// CHECK-NEXT: }

