// RUN: %rrc %s -o %t.o --relocation-mode pic -Oaggressive --reuse-across-call
// RUN: %cc %t.o %S/per_ctor_box_sizing_mixed_arms.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.exe

// The `#[repr(fixed)]` (uniform max-arm box sizing) control for
// per_ctor_box_sizing_mixed_arms.rr: the same rotate/total/drive program and
// the SAME C harness (field offsets are identical under fixed vs
// per-constructor — only the trailing padding differs), but every cell is
// pinned to the 32-byte max-arm width. This exercises the uniform token/free
// path end to end; any alloc/token/free size disagreement corrupts the
// allocator and shows up here (and under the suite's sanitizer configs).

#[repr(fixed)]
enum T {
    One(i64),             // 8 header + 8  -> padded to 32-byte max-arm cell
    Two(i64, i64),        // 8 header + 16 -> padded to 32-byte max-arm cell
    Three(i64, i64, i64), // 8 header + 24 = 32-byte cell
    Nil
}

// Rotate the arms: each step consumes one cell and constructs a cell of a
// *different* arm — under `fixed` every cell is the same 32-byte size, so a
// dead donor always pairs in place.
fn rotate(t: T, depth: i64, acc: i64) -> i64 {
    if depth == 0 {
        total(t, acc)
    } else {
        match t {
            T::One(a) => rotate(T::Two{a, a + 1}, depth - 1, acc + 1),
            T::Two(a, b) => rotate(T::Three{a, b, a + b}, depth - 1, acc + 1),
            T::Three(a, _, c) => rotate(T::One{a + c}, depth - 1, acc + 1),
            T::Nil => acc
        }
    }
}

// Consume through a call boundary so the callee's dec of `t` is not pinned
// to an arm (tag-unknown), driving the max-arm-token free path.
fn total(t: T, acc: i64) -> i64 {
    match t {
        T::One(a) => acc + a,
        T::Two(a, b) => acc + a + b,
        T::Three(a, b, c) => acc + a + b + c,
        T::Nil => acc
    }
}

fn drive(i: i64, acc: i64) -> i64 {
    if i <= 0 {
        acc
    } else {
        drive(i - 1, acc + rotate(T::One{i}, 3, 0))
    }
}

fn mixed_arms(n: i64) -> i64 {
    drive(n, 0)
}

extern "C" trampoline "mixed_arms_test_ffi" = mixed_arms;
