// The Rust surface parser accepts this construct. Structural coverage
// lives in the reussir-syntax unit tests; this lit test guards
// end-to-end parse acceptance (`--check` = parse, no elaboration).
// RUN: %reussir-syntax --check %s

struct Foo { x: bool }

fn test(foo: bool) -> i32 {
    if foo { 1 } else { 2 }
}

fn test_parenthesized() -> i32 {
    if (Foo { x: true }.x) { 1 } else { 2 }
}
