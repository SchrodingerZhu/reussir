// RUN: %rrc %s --emit hir --no-source-locations -o - | %FileCheck %s
// RUN: %rrc %s --emit mir --no-source-locations -o - | %FileCheck %s --check-prefix=FULL

enum Wrapper {
    Val(i32),
    None
}

fn test(x : Wrapper) -> i32 {
    match x {
        Wrapper::Val(0) => 100,
        Wrapper::Val(1) => 200,
        Wrapper::Val(n) => n,
        Wrapper::None => 0
    }
}

// CHECK: [shared] enum #Wrapper { Val(i32), None() };
// CHECK-EMPTY:
// CHECK-NEXT: fn #test(v0 (x): #Wrapper) -> i32 {
// CHECK-NEXT:     match v0 : #Wrapper {
// CHECK-NEXT:         switch scrut {
// CHECK-NEXT:             #0 => {
// CHECK-NEXT:                 switch scrut.0 {
// CHECK-NEXT:                     0 => {
// CHECK-NEXT:                         => 100 : i32
// CHECK-NEXT:                     }
// CHECK-NEXT:                     1 => {
// CHECK-NEXT:                         => 200 : i32
// CHECK-NEXT:                     }
// CHECK-NEXT:                     _ => {
// CHECK-NEXT:                         v1=scrut.0 => v1 : i32
// CHECK-NEXT:                     }
// CHECK-NEXT:                 }
// CHECK-NEXT:             }
// CHECK-NEXT:             #1 => {
// CHECK-NEXT:                 => 0 : i32
// CHECK-NEXT:             }
// CHECK-NEXT:         }
// CHECK-NEXT:     } : i32
// CHECK-NEXT: }

// FULL: record @_RC7Wrapper : shared enum Wrapper { @_RNvC7Wrapper3Val Val(i32), @_RNvC7Wrapper4None None() };
// FULL-EMPTY:
// FULL-NEXT: fn @_RC4test(v0 (x): Wrapper) -> i32 {
// FULL-NEXT:     match v0 : Wrapper {
// FULL-NEXT:         switch scrut {
// FULL-NEXT:             #0 => {
// FULL-NEXT:                 switch scrut.0 {
// FULL-NEXT:                     0 => {
// FULL-NEXT:                         => 100 : i32
// FULL-NEXT:                     }
// FULL-NEXT:                     1 => {
// FULL-NEXT:                         => 200 : i32
// FULL-NEXT:                     }
// FULL-NEXT:                     _ => {
// FULL-NEXT:                         v1=scrut.0 => v1 : i32
// FULL-NEXT:                     }
// FULL-NEXT:                 }
// FULL-NEXT:             }
// FULL-NEXT:             #1 => {
// FULL-NEXT:                 => 0 : i32
// FULL-NEXT:             }
// FULL-NEXT:         }
// FULL-NEXT:     } : i32
// FULL-NEXT: }
