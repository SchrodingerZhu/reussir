// `#[main]` names the program's entry point. It is exported under the fixed
// symbol `__reussir_main`, through the same trampoline path an explicit
// `extern "C" trampoline` takes.
//
// An executable is then built *around* it: the launcher
// (crates/reussir-rt/launcher/main.rs) is a real Rust `main`, so rustc emits
// the C entry that runs `lang_start` and the program starts under the full
// Rust runtime. main_attribute_link.rr does that end to end.

// RUN: %rrc %s --emit hir --no-source-locations -o - | %FileCheck %s

// The attribute lowers to an ordinary C-ABI export of the marked function.
// CHECK: extern "C" trampoline "__reussir_main" = #entry;
// CHECK: pub fn #entry() -> () {

// That export is the *only* record of the entry point, which is what keeps
// the stage chain re-entrant: the entry point survives into the HIR and MIR
// dumps, so a build resumed from one of them is the build from source. Were
// it tracked beside the IR instead, a resumed build would quietly lose it.
// RUN: %rrc %s --emit hir --no-source-locations -o %t.a.hir
// RUN: %rrc %t.a.hir --emit hir --no-source-locations -o %t.b.hir
// RUN: diff %t.a.hir %t.b.hir
// RUN: %rrc %s --emit mir --no-source-locations -o %t.direct.mir
// RUN: %rrc %t.a.hir --emit mir --no-source-locations -o %t.via.mir
// RUN: diff %t.direct.mir %t.via.mir
// RUN: %FileCheck %s --check-prefix=CHECK --input-file=%t.a.hir
// RUN: %FileCheck %s --check-prefix=RESUMED --input-file=%t.direct.mir

// RESUMED: extern "C" trampoline "__reussir_main" =

// Resuming to an object works the same way; main_attribute_link.rr takes it
// the rest of the way to a running program.
// RUN: %rrc %t.a.hir -o %t.resumed.o --relocation-mode pic

// One entry point per program…
// RUN: %not %rrc %S/main_attribute/two_mains.rr --emit hir -o - 2>&1 | %FileCheck %s --check-prefix=TWO
// TWO: only one `#[main]`

// …it cannot be generic (nothing supplies type arguments at startup)…
// RUN: %not %rrc %S/main_attribute/generic.rr --emit hir -o - 2>&1 | %FileCheck %s --check-prefix=GENERIC
// GENERIC: `#[main]` cannot be generic

// …and it takes no parameters, because that is how the runtime calls it.
// RUN: %not %rrc %S/main_attribute/params.rr --emit hir -o - 2>&1 | %FileCheck %s --check-prefix=PARAMS
// PARAMS: `#[main]` takes no parameters

// RUN: %not %rrc %S/main_attribute/malformed.rr --emit hir -o - 2>&1 | %FileCheck %s --check-prefix=MALFORMED
// MALFORMED: malformed `#[main]`

fn twice(n: u64) -> u64 {
    n + n
}

#[main]
pub fn entry() {
    let doubled = twice(21);
}
