// RUN: %rrc %s --emit hir -o - | %FileCheck %s
// RUN: %rrc %s --emit mir -o - | %FileCheck %s --check-prefix=FULL

fn test(x : i32, flag : bool) -> i32 {
    match x {
        0 => 100,
        y if flag => y,
        _ => 0
    }
}

// CHECK: fn #test(v0 (x): i32, v1 (flag): bool) -> i32 {
// CHECK-NEXT:     match v0 : i32 {
// CHECK-NEXT:         switch scrut {
// CHECK-NEXT:             0 => {
// CHECK-NEXT:                 => 100 : i32
// CHECK-NEXT:             }
// CHECK-NEXT:             _ => {
// CHECK-NEXT:                 v2=scrut if v1 : bool {
// CHECK-NEXT:                     => v2 : i32
// CHECK-NEXT:                 } else {
// CHECK-NEXT:                     => 0 : i32
// CHECK-NEXT:                 }
// CHECK-NEXT:             }
// CHECK-NEXT:         }
// CHECK-NEXT:     } : i32
// CHECK-NEXT: }

