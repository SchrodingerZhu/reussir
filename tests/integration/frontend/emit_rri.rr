// `--emit rri`: the package interface — the HIR reduced to the export
// closure behind a versioned header. `pub` generics and the generics their
// bodies call ship whole; every ground function the shipped surface mentions
// ships as a bodyless prototype (its symbol stays in this package's
// artifacts); records close over the mentioned types' fields; nothing else
// crosses. The file table is package-root-relative and functions print in
// path order, so the artifact is byte-stable across checkouts.

// RUN: %rrc --package-root %S/emit_rri --package-name demo --emit rri -o - | %FileCheck %s
// RUN: %rrc --package-root %S/emit_rri --package-name demo --emit rri -o - | %FileCheck %s --check-prefix=ABSENT

// CHECK: interface 2 package "demo" producer "rrc
// CHECK: 0 = "lib.rr";
// CHECK: 1 = "util.rr";

// The `pub` surface record keeps its marker — and its members keep their
// per-field visibility; the private record ships (a shipped prototype
// mentions it) without one.
// CHECK: pub [shared] struct #demo::Point
// CHECK-SAME: { pub "x": i64, "y": i64 };
// CHECK: [shared] struct #demo::Secret

// Ground functions — private or `pub`, same-module or cross-module — are
// bodyless prototypes, in path order.
// CHECK: fn #demo::bar(v0 (x): i64) -> i64 in 0 [{{[0-9]+}}..{{[0-9]+}}];
// CHECK: fn #demo::hidden(v0 (s): #demo::Secret) -> i64 in 0 [{{[0-9]+}}..{{[0-9]+}}];
// CHECK: pub fn #demo::origin() -> #demo::Point in 0 [{{[0-9]+}}..{{[0-9]+}}];

// The `pub` generic and the private generic it calls ship with bodies.
// CHECK: pub fn #demo::scale<$1 (T)>(v0 (x): $1) -> i64 in 0 [{{[0-9]+}}..{{[0-9]+}}] {
// CHECK: fn #demo::scale_impl<$0 (T)>(v0 (x): $0, v1 (k): i64) -> i64 in 0 [{{[0-9]+}}..{{[0-9]+}}] {

// CHECK: pub fn #demo::util::mul(v0 (a): i64, v1 (b): i64) -> i64 in 1 [{{[0-9]+}}..{{[0-9]+}}];

// A private function nothing exported reaches stays home — checked over the
// whole artifact (its path would sort between the prototypes above). And the
// closure stops at the ground boundary: `scale_impl` → `bar` ships `bar` as
// a prototype, but `baz` — reached only from `bar`'s body, which is compiled
// in this package — stays hidden entirely.
// ABSENT-NOT: never_exported
// ABSENT-NOT: baz

// The emission is deterministic: two runs, one artifact.
// RUN: %rrc --package-root %S/emit_rri --package-name demo --emit rri -o %t.a.rri
// RUN: %rrc --package-root %S/emit_rri --package-name demo --emit rri -o %t.b.rri
// RUN: diff %t.a.rri %t.b.rri

// An interface describes a package; a bare file has no authoritative name
// for the header.
// RUN: %not %rrc %S/emit_rri/util.rr --emit rri -o %t.rri 2>&1 | %FileCheck %s --check-prefix=NOPKG
// NOPKG: --emit rri describes a package interface

// And an interface is not a resumable program: re-entering one as a plain
// HIR dump is refused (loading is `--extern`'s job, in a later change).
// RUN: cp %t.a.rri %t.fake.hir
// RUN: %not %rrc %t.fake.hir --emit mir -o - 2>&1 | %FileCheck %s --check-prefix=NOENTRY
// NOENTRY: this is a package interface (`.rri`), not a plain HIR program
