// FULL-NEXT:                     0 => {
// FULL-NEXT:                         => 1 : i32
// FULL-NEXT:                     }
// FULL-NEXT:                     _ => {
// FULL-NEXT:                         v1=scrut.0 => v1 : i32
// FULL-NEXT:                     }
// FULL-NEXT:                 }
// FULL-NEXT:             }
// FULL-NEXT:             #1 => {
// FULL-NEXT:                 switch scrut.0 {
// FULL-NEXT:                     0 => {
// FULL-NEXT:                         => 2 : i32
// FULL-NEXT:                     }
// FULL-NEXT:                     _ => {
// FULL-NEXT:                         => 3 : i32
