// RUN: %rrc %s --emit hir --no-source-locations -o - | %FileCheck %s
// RUN: %rrc %s --emit mir --no-source-locations -o - | %FileCheck %s --check-prefix=FULL

enum Result {
    Ok(i32),
    Err(i32)
}

fn test(x : Result) -> i32 {
    match x {
        Result::Ok(0) => 1,
        Result::Ok(n) => n,
        Result::Err(0) => 2,
        Result::Err(_) => 3
    }
}

// CHECK: [shared] enum #Result { Ok(i32), Err(i32) };
// CHECK-EMPTY:
// CHECK-NEXT: fn #test(v0 (x): #Result) -> i32 {
// CHECK-NEXT:     match v0 : #Result {
// CHECK-NEXT:         switch scrut {
// CHECK-NEXT:             #0 => {
// CHECK-NEXT:                 switch scrut.0 {
// CHECK-NEXT:                     0 => {
// CHECK-NEXT:                         => 1 : i32
// CHECK-NEXT:                     }
// CHECK-NEXT:                     _ => {
// CHECK-NEXT:                         v1=scrut.0 => v1 : i32
// CHECK-NEXT:                     }
// CHECK-NEXT:                 }
// CHECK-NEXT:             }
// CHECK-NEXT:             #1 => {
// CHECK-NEXT:                 switch scrut.0 {
// CHECK-NEXT:                     0 => {
// CHECK-NEXT:                         => 2 : i32
// CHECK-NEXT:                     }
// CHECK-NEXT:                     _ => {
// CHECK-NEXT:                         => 3 : i32
// CHECK-NEXT:                     }
// CHECK-NEXT:                 }
// CHECK-NEXT:             }
// CHECK-NEXT:         }
// CHECK-NEXT:     } : i32
// CHECK-NEXT: }

