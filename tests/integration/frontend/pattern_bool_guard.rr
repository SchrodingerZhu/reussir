// RUN: %rrc %s --emit hir --no-source-locations -o - | %FileCheck %s
// RUN: %rrc %s --emit mir --no-source-locations -o - | %FileCheck %s --check-prefix=FULL

fn test(x : bool, y : i32) -> i32 {
    match x {
        true if y > 0 => y,
        true => 0,
        false => 1
    }
}

// CHECK: fn #test(v0 (x): bool, v1 (y): i32) -> i32 {
// CHECK-NEXT:     match v0 : bool {
// CHECK-NEXT:         switch scrut {
// CHECK-NEXT:             true => {
// CHECK-NEXT:                 if (v1 : i32 > 0 : i32) : bool {
// CHECK-NEXT:                     => v1 : i32
// CHECK-NEXT:                 } else {
// CHECK-NEXT:                     => 0 : i32
// CHECK-NEXT:                 }
// CHECK-NEXT:             }
// CHECK-NEXT:             false => {
// CHECK-NEXT:                 => 1 : i32
// CHECK-NEXT:             }
// CHECK-NEXT:         }
// CHECK-NEXT:     } : i32
// CHECK-NEXT: }

