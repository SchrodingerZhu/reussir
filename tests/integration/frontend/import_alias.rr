// The `import`/`alias` path abbreviations (docs/design/import-alias.md):
// file-scoped bindings that expand before resolution, so the abbreviated
// spellings elaborate to exactly the same HIR as the fully-qualified ones.

// RUN: %rrc %s --emit hir --no-source-locations -o - | %FileCheck %s
// RUN: %rrc %s -o %t.o

// `import` binds the path's last segment; `alias` and `import … as …` bind
// the given name. One binding serves types, values, and constructors alike.
import core::intrinsic::math;
alias arr = core::intrinsic::array;
import core::intrinsic::math::sqrt as rt;
alias L = List;

enum List<T> { Nil, Cons(T, List<T>) }

// CHECK: fn #hypot(v0 (x): f64, v1 (y): f64) -> f64 {
// CHECK: intrinsic#math#sqrt#0
pub fn hypot(x : f64, y : f64) -> f64 {
    math::sqrt(x * x + y * y, 0)
}

// A bare imported intrinsic function; locals are unaffected.
// CHECK: fn #root(v0 (x): f64) -> f64 {
// CHECK-NEXT: intrinsic#math#sqrt#0(v0 : f64) : f64
pub fn root(x : f64) -> f64 {
    rt(x, 0)
}

// The aliased array family, including a mixed spelling: expansion happens
// per reference, so the full path stays available alongside the alias.
// CHECK: fn #bump(v0 (a): [f64; 8], v1 (i): i64, v2 (v): f64) -> [f64; 8] {
// CHECK: array#set(v0 : [f64; 8]{{.*}}array#get(v0
pub fn bump(a : [f64; 8], i : i64, v : f64) -> [f64; 8] {
    arr::set(a, i, core::intrinsic::array::get(a, i) + v)
}

// The record alias covers type annotations, constructor calls (incl. the
// nullary spelling), and match qualifiers.
// CHECK: fn #len(v0 (l): List<i64>) -> i64 {
pub fn len(l : L<i64>) -> i64 {
    match l {
        L::Nil => 0,
        L::Cons(x, xs) => 1 + len(xs)
    }
}

// CHECK: fn #make() -> List<i64> {
pub fn make() -> L<i64> {
    L::Cons{1, L::Nil}
}

pub fn main(x : f64, y : f64) -> f64 {
    hypot(x, y) + root(x)
}

extern "C" trampoline "reussir_main" = main;
