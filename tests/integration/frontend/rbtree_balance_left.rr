// RUN: %rrc %s --emit hir --no-source-locations -o - | %FileCheck %s

enum [value] Color {
    Red,
    Black
}

enum Tree<T : Num> {
    Branch(Color, Tree<T>, T, Tree<T>),
    Leaf
}

fn balance_left<T : Num>(l : Tree<T>, k : T, r : Tree<T>) -> Tree<T> {
    match l {
        Tree::Branch(_, Tree::Branch(Color::Red {}, lx, kx, rx), ky, ry) =>
            Tree::Branch{
                Color::Red {},
                Tree::Branch{Color::Black {}, lx, kx, rx},
                ky,
                Tree::Branch{Color::Black {}, ry, k, r}
            },

        Tree::Branch(_, ly, ky, Tree::Branch(Color::Red {}, lx, kx, rx)) =>
            Tree::Branch{
                Color::Red {},
                Tree::Branch{Color::Black {}, ly, ky, lx},
                kx,
                Tree::Branch{Color::Black {}, rx, k, r}
            },

        Tree::Branch(_, lx, kx, rx) =>
            Tree::Branch{
                Color::Black {},
                Tree::Branch{Color::Red {}, lx, kx, rx},
                k,
                r
            },

        Tree::Leaf => Tree::Leaf {}
    }
}

// CHECK: [value] enum #Color { Red(), Black() };
// CHECK-EMPTY:
// CHECK-NEXT: [shared] enum #Tree<$0 (T)> { Branch(#Color, #Tree::<$0>, $0, #Tree::<$0>), Leaf() };
// CHECK-EMPTY:
// CHECK-NEXT: fn #balance_left<$1 (T)>(v0 (l): #Tree::<$1>, v1 (k): $1, v2 (r): #Tree::<$1>) -> #Tree::<$1> {
// CHECK-NEXT:     match v0 : #Tree::<$1> {
// CHECK-NEXT:         switch scrut {
// CHECK-NEXT:             #0 => {
// CHECK-NEXT:                 switch scrut.1 {
// CHECK-NEXT:                     #0 => {
// CHECK-NEXT:                         switch scrut.1.0 {
// CHECK-NEXT:                             #0 => {
// CHECK-NEXT:                                 v3=scrut.1.1 v4=scrut.1.2 v5=scrut.1.3 v6=scrut.2 v7=scrut.3 => #Tree::<$1>#0(#Color#0() : #Color, #Tree::<$1>#0(#Color#1() : #Color, v3 : #Tree::<$1>, v4 : $1, v5 : #Tree::<$1>) : #Tree::<$1>, v6 : $1, #Tree::<$1>#0(#Color#1() : #Color, v7 : #Tree::<$1>, v1 : $1, v2 : #Tree::<$1>) : #Tree::<$1>) : #Tree::<$1>
// CHECK-NEXT:                             }
// CHECK-NEXT:                             #1 => {
// CHECK-NEXT:                                 switch scrut.3 {
// CHECK-NEXT:                                     #0 => {
// CHECK-NEXT:                                         switch scrut.3.0 {
// CHECK-NEXT:                                             #0 => {
// CHECK-NEXT:                                                 v8=scrut.1 v9=scrut.2 v10=scrut.3.1 v11=scrut.3.2 v12=scrut.3.3 => #Tree::<$1>#0(#Color#0() : #Color, #Tree::<$1>#0(#Color#1() : #Color, v8 : #Tree::<$1>, v9 : $1, v10 : #Tree::<$1>) : #Tree::<$1>, v11 : $1, #Tree::<$1>#0(#Color#1() : #Color, v12 : #Tree::<$1>, v1 : $1, v2 : #Tree::<$1>) : #Tree::<$1>) : #Tree::<$1>
// CHECK-NEXT:                                             }
// CHECK-NEXT:                                             #1 => {
// CHECK-NEXT:                                                 v13=scrut.1 v15=scrut.3 v14=scrut.2 => #Tree::<$1>#0(#Color#1() : #Color, #Tree::<$1>#0(#Color#0() : #Color, v13 : #Tree::<$1>, v14 : $1, v15 : #Tree::<$1>) : #Tree::<$1>, v1 : $1, v2 : #Tree::<$1>) : #Tree::<$1>
// CHECK-NEXT:                                             }
// CHECK-NEXT:                                         }
// CHECK-NEXT:                                     }
// CHECK-NEXT:                                     #1 => {
// CHECK-NEXT:                                         v13=scrut.1 v15=scrut.3 v14=scrut.2 => #Tree::<$1>#0(#Color#1() : #Color, #Tree::<$1>#0(#Color#0() : #Color, v13 : #Tree::<$1>, v14 : $1, v15 : #Tree::<$1>) : #Tree::<$1>, v1 : $1, v2 : #Tree::<$1>) : #Tree::<$1>
// CHECK-NEXT:                                     }
// CHECK-NEXT:                                 }
// CHECK-NEXT:                             }
// CHECK-NEXT:                         }
// CHECK-NEXT:                     }
// CHECK-NEXT:                     #1 => {
// CHECK-NEXT:                         switch scrut.3 {
// CHECK-NEXT:                             #0 => {
// CHECK-NEXT:                                 switch scrut.3.0 {
// CHECK-NEXT:                                     #0 => {
// CHECK-NEXT:                                         v8=scrut.1 v9=scrut.2 v10=scrut.3.1 v11=scrut.3.2 v12=scrut.3.3 => #Tree::<$1>#0(#Color#0() : #Color, #Tree::<$1>#0(#Color#1() : #Color, v8 : #Tree::<$1>, v9 : $1, v10 : #Tree::<$1>) : #Tree::<$1>, v11 : $1, #Tree::<$1>#0(#Color#1() : #Color, v12 : #Tree::<$1>, v1 : $1, v2 : #Tree::<$1>) : #Tree::<$1>) : #Tree::<$1>
// CHECK-NEXT:                                     }
// CHECK-NEXT:                                     #1 => {
// CHECK-NEXT:                                         v13=scrut.1 v15=scrut.3 v14=scrut.2 => #Tree::<$1>#0(#Color#1() : #Color, #Tree::<$1>#0(#Color#0() : #Color, v13 : #Tree::<$1>, v14 : $1, v15 : #Tree::<$1>) : #Tree::<$1>, v1 : $1, v2 : #Tree::<$1>) : #Tree::<$1>
// CHECK-NEXT:                                     }
// CHECK-NEXT:                                 }
// CHECK-NEXT:                             }
// CHECK-NEXT:                             #1 => {
// CHECK-NEXT:                                 v13=scrut.1 v15=scrut.3 v14=scrut.2 => #Tree::<$1>#0(#Color#1() : #Color, #Tree::<$1>#0(#Color#0() : #Color, v13 : #Tree::<$1>, v14 : $1, v15 : #Tree::<$1>) : #Tree::<$1>, v1 : $1, v2 : #Tree::<$1>) : #Tree::<$1>
// CHECK-NEXT:                             }
// CHECK-NEXT:                         }
// CHECK-NEXT:                     }
// CHECK-NEXT:                 }
// CHECK-NEXT:             }
// CHECK-NEXT:             #1 => {
// CHECK-NEXT:                 => #Tree::<$1>#1() : #Tree::<$1>
// CHECK-NEXT:             }
// CHECK-NEXT:         }
// CHECK-NEXT:     } : #Tree::<$1>
// CHECK-NEXT: }
