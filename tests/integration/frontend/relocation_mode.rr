// RUN: %rrc --help | %FileCheck %s --check-prefix=HELP
// RUN: %rrc %s -o %t.pic.ll --emit llvm-ir --relocation-mode pic
// RUN: %rrc %s -o %t.dynamic.ll --emit llvm-ir --relocation-mode dynamic-no-pic
// RUN: %not %rrc %s -o %t.invalid.ll --emit llvm-ir --relocation-mode invalid 2>&1 | %FileCheck %s --check-prefix=ERR

// HELP: --relocation-mode <RELOCATION_MODE>
// ERR: unknown --relocation-mode `invalid`

pub fn relocation_mode_test(x : u32) -> u32 {
    x
}
