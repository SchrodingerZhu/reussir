// CHECK-NEXT:             #1 => {
// CHECK-NEXT:                 => #Option::<i32>#1() : #Option::<i32>
// CHECK-NEXT:             }
// CHECK-NEXT:         }
// CHECK-NEXT:     } : #Option::<i32>
// CHECK-NEXT: }

