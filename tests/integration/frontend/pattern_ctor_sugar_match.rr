// CHECK-NEXT:             #0 => {
// CHECK-NEXT:                 => true : bool
// CHECK-NEXT:             }
// CHECK-NEXT:             #1 => {
// CHECK-NEXT:                 => false : bool
// CHECK-NEXT:             }
// CHECK-NEXT:         }
// CHECK-NEXT:     } : bool
// CHECK-NEXT: }
// CHECK-EMPTY:
// CHECK-NEXT: fn #none_val() -> #Option::<i32> {
// CHECK-NEXT:     #Option::<i32>#1() : #Option::<i32>
// CHECK-NEXT: }
// CHECK-EMPTY:
// CHECK-NEXT: fn #map_to_none(v0 (x): #Option::<i32>) -> #Option::<i32> {
// CHECK-NEXT:     match v0 : #Option::<i32> {
