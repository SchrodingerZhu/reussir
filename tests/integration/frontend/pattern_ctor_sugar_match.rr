// RUN: %rrc %s --emit hir --no-source-locations -o - | %FileCheck %s
// RUN: %rrc %s --emit mir --no-source-locations -o - | %FileCheck %s --check-prefix=FULL

enum Option<T> {
    Some(T),
    None
}

fn is_some(x : Option<i32>) -> bool {
    match x {
        Option::Some(_) => true,
        Option::None{} => false
    }
}

fn none_val() -> Option<i32> {
    Option::None
}

fn map_to_none(x : Option<i32>) -> Option<i32> {
    match x {
        Option::Some(_) => Option::None,
        Option::None{} => Option::None
    }
}

