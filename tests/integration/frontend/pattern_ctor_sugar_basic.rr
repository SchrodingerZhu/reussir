// RUN: %rrc %s --emit hir --no-source-locations -o - | %FileCheck %s
// RUN: %rrc %s --emit mir --no-source-locations -o - | %FileCheck %s --check-prefix=FULL

enum Option<T> {
    Some(T),
    None
}

fn foo() -> Option<i32> {
    Option::None
}

fn bar() -> Option<i32> {
    Option::None{}
}

// CHECK: [shared] enum #Option<$0 (T)> { Some($0), None() };
// CHECK-EMPTY:
// CHECK-NEXT: fn #foo() -> #Option::<i32> {
// CHECK-NEXT:     #Option::<i32>#1() : #Option::<i32>
// CHECK-NEXT: }
// CHECK-EMPTY:
// CHECK-NEXT: fn #bar() -> #Option::<i32> {
// CHECK-NEXT:     #Option::<i32>#1() : #Option::<i32>
// CHECK-NEXT: }

// FULL: record @_RIC6OptionlE : shared enum Option::<i32> { @_RNvIC6OptionlE4Some Some(i32), @_RNvIC6OptionlE4None None() };
// FULL-EMPTY:
// FULL-NEXT: fn @_RC3bar() -> Option::<i32> {
// FULL-NEXT:     @_RIC6OptionlE::#1() : Option::<i32>
// FULL-NEXT: }
// FULL-EMPTY:
// FULL-NEXT: fn @_RC3foo() -> Option::<i32> {
// FULL-NEXT:     @_RIC6OptionlE::#1() : Option::<i32>
// FULL-NEXT: }
