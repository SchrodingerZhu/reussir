// RUN: %rrc %s --emit hir --no-source-locations -o - | %FileCheck %s
// RUN: %rrc %s --emit mir --no-source-locations -o - | %FileCheck %s --check-prefix=FULL

enum Pair {
    MkPair(bool, bool)
}

fn test(x : Pair) -> i32 {
    match x {
        Pair::MkPair(true, true) => 1,
        Pair::MkPair(true, false) => 2,
        Pair::MkPair(false, true) => 3,
        Pair::MkPair(false, false) => 4
    }
}

// CHECK: [shared] enum #Pair { MkPair(bool, bool) };
// CHECK-EMPTY:
// CHECK-NEXT: fn #test(v0 (x): #Pair) -> i32 {
// CHECK-NEXT:     match v0 : #Pair {
// CHECK-NEXT:         switch scrut {
// CHECK-NEXT:             #0 => {
// CHECK-NEXT:                 switch scrut.0 {
// CHECK-NEXT:                     true => {
// CHECK-NEXT:                         switch scrut.1 {
// CHECK-NEXT:                             true => {
// CHECK-NEXT:                                 => 1 : i32
// CHECK-NEXT:                             }
// CHECK-NEXT:                             false => {
// CHECK-NEXT:                                 => 2 : i32
// CHECK-NEXT:                             }
// CHECK-NEXT:                         }
// CHECK-NEXT:                     }
// CHECK-NEXT:                     false => {
// CHECK-NEXT:                         switch scrut.1 {
// CHECK-NEXT:                             true => {
// CHECK-NEXT:                                 => 3 : i32
// CHECK-NEXT:                             }
// CHECK-NEXT:                             false => {
// CHECK-NEXT:                                 => 4 : i32
// CHECK-NEXT:                             }
// CHECK-NEXT:                         }
// CHECK-NEXT:                     }
// CHECK-NEXT:                 }
// CHECK-NEXT:             }
// CHECK-NEXT:         }
// CHECK-NEXT:     } : i32
// CHECK-NEXT: }

