// REQUIRES: rrepl
// RUN: %rrepl -i %s -lerror | %FileCheck %s
// RUN: %rrepl -i %s -lerror -Onone | %FileCheck %s

// Test: pattern matching on a `[value]` (inline, unboxed) enum. The match
// scrutinee arrives by value, so dispatch spills it to a stack reference
// (`reussir.ref.spilled` — always at unspecified capability) instead of
// borrowing an rc box like a default (shared) enum would.

:{
enum [value] Node {
    Tip(bool),
    Bin(bool, bool)
}
}:
// CHECK: Definition added.

:{
fn num_of_true(n: Node) -> i32 {
    match n {
        Node::Tip(true) => 1,
        Node::Tip(false) => 0,
        Node::Bin(true, true) => 2,
        Node::Bin(true, false) => 1,
        Node::Bin(false, true) => 1,
        Node::Bin(false, false) => 0
    }
}
}:
// CHECK: Definition added.

num_of_true(Node::Tip{true})
// CHECK: 1 : i32

num_of_true(Node::Tip{false})
// CHECK: 0 : i32

num_of_true(Node::Bin{true, true})
// CHECK: 2 : i32

num_of_true(Node::Bin{true, false})
// CHECK: 1 : i32

num_of_true(Node::Bin{false, true})
// CHECK: 1 : i32

num_of_true(Node::Bin{false, false})
// CHECK: 0 : i32

// A payload binding loads through the spilled reference's projection.
:{
enum [value] Wrap {
    Empty,
    Full(i64)
}
}:
// CHECK: Definition added.

:{
fn get_or(w: Wrap, default: i64) -> i64 {
    match w {
        Wrap::Empty => default,
        Wrap::Full(v) => v
    }
}
}:
// CHECK: Definition added.

get_or(Wrap::Full{7}, 0)
// CHECK: 7 : i64

get_or(Wrap::Empty, 9)
// CHECK: 9 : i64

// A managed (shared) payload inside a value enum: the case projection is an
// rc link loaded out of the unspecified-capability spilled reference.
struct Box { value: i64 }
// CHECK: Definition added.

:{
enum [value] MaybeBox {
    Nothing,
    Just(Box)
}
}:
// CHECK: Definition added.

:{
fn unbox_or(m: MaybeBox, default: i64) -> i64 {
    match m {
        MaybeBox::Nothing => default,
        MaybeBox::Just(b) => b.value
    }
}
}:
// CHECK: Definition added.

unbox_or(MaybeBox::Just{Box { value: 21 }}, 0)
// CHECK: 21 : i64

unbox_or(MaybeBox::Nothing, 4)
// CHECK: 4 : i64
