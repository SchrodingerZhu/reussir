// REQUIRES: asan
// UNSUPPORTED: darwin
// ASan+LSan gate over frontend/ffi_vec_record_e2e.rr: Reussir boxes round
// trip through a Rust Vec (clone via the acquire glue, drop via release,
// the vector itself dropped by the Rust wrappers). Any leak reported here
// is a real cross-boundary ownership bug. The linked Rust bitcode is
// instrumented together with the Reussir IR (`-x ir` + `%asan_flags`).

// RUN: %rrc %S/../../frontend/ffi_vec_record_e2e.rr -o %t.ll -t llvm-ir --relocation-mode pic -Odefault
// RUN: %cc %asan_flags -c -x ir %t.ll -o %t.o
// RUN: %cc %asan_flags %t.o %S/../../frontend/ffi_vec_record_e2e.c %reussir_rt_asan -o %t.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.exe
