// std::hash end to end: user `Hash` impls (ground and generic)
// dispatching through the `Hasher` trait into the pure value hashers,
// the scalar write helpers and seeding.
//
// The VECTORS digests are pinned against the documented algorithms
// (classic Fx for FastHasher; an aHash-derived state with the
// primitive update specialization for StrongHasher), computed
// independently. They guard the chaining and state handling: any drift
// shows up as a changed number rather than as quietly different hashes.

// RUN: %rene build --manifest-path %S/std_hash_test/rene.ncl --build-dir %t.bdir --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}std_hash_test

// RUN: %t.bdir/release/std_hash_test%exe_ext < %S/std_hash_test/vectors.in | %FileCheck %s --check-prefix=VECTORS
// fast/strong over words 1 ++ 2
// VECTORS:      7659469028595837896
// VECTORS-NEXT: 14389719906271566111
// scalar u64 42, default seed
// VECTORS-NEXT: 6807129317463932018
// VECTORS-NEXT: 7367054577293084200
// scalar u64 42, seed 12345
// VECTORS-NEXT: 2483310807519886546
// VECTORS-NEXT: 15056869511168324300
// u32 7, u16 8, u8 9, bool true, char 'z'
// VECTORS-NEXT: 11710304454334885276
// VECTORS-NEXT: 16033770625569700645
// streaming u64 5 under seed 99
// VECTORS-NEXT: 18396363454642202825
// VECTORS-NEXT: 6887771581839605075

// RUN: %t.bdir/release/std_hash_test%exe_ext < %S/std_hash_test/properties.in | %FileCheck %s --check-prefix=PROPS
// PROPS:      1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// the associated constructors (default/from_entropy) agree with
// the free ones, through a generic consumer and type prefixes
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
// PROPS-NEXT: 1
