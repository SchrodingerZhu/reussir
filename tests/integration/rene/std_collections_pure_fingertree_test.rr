// A downstream package instantiates every generic finger-tree operation.
// Numeric cases cover both ends, cached measures, random access, splitting,
// concatenation, editing, traversal, persistence, and shared payloads.

// RUN: %rene build --manifest-path %S/std_collections_pure_fingertree_test/rene.ncl --build-dir %t.bdir --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}std_collections_pure_fingertree_test

// RUN: %t.bdir/release/std_collections_pure_fingertree_test%exe_ext < %S/std_collections_pure_fingertree_test/new.in | %FileCheck %s --check-prefix=NEW
