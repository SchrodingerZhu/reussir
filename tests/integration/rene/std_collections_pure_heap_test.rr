// BINOMIAL:      1
// BINOMIAL-NEXT: 1
// BINOMIAL-NEXT: 1
// BINOMIAL-NEXT: 1
// BINOMIAL-NEXT: 1
// BINOMIAL-NEXT: 1
// BINOMIAL-NEXT: 1

