// A downstream package instantiates both persistent priority queues.
// Cases cover the public API, persistence of shared versions, heapsort
// output order, a model-checked insert/delete-min churn, and agreement
// between the two implementations on identical inputs.

// RUN: %rene build --manifest-path %S/std_collections_pure_heap_test/rene.ncl --build-dir %t.bdir --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}std_collections_pure_heap_test

// RUN: %t.bdir/release/std_collections_pure_heap_test%exe_ext < %S/std_collections_pure_heap_test/pairing_basics.in | %FileCheck %s --check-prefix=PAIRING
// PAIRING:      1
// PAIRING-NEXT: 1
// PAIRING-NEXT: 1
// PAIRING-NEXT: 1
// PAIRING-NEXT: 1
// PAIRING-NEXT: 1
// PAIRING-NEXT: 1

