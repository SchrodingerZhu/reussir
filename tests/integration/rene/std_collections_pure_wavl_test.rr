// A downstream package instantiates the generic WAVL set and map. Cases
// cover the public API, ascending iteration, persistence of shared trees,
// and a pseudorandom insert/remove churn cross-checked against a
// sorted-list model.

// RUN: %rene build --manifest-path %S/std_collections_pure_wavl_test/rene.ncl --build-dir %t.bdir --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}std_collections_pure_wavl_test

// RUN: %t.bdir/release/std_collections_pure_wavl_test%exe_ext < %S/std_collections_pure_wavl_test/set_basics.in | %FileCheck %s --check-prefix=SET
// SET:      1
// SET-NEXT: 1
// SET-NEXT: 1
// SET-NEXT: 1
// SET-NEXT: 1
// SET-NEXT: 1
// SET-NEXT: 1

// RUN: %t.bdir/release/std_collections_pure_wavl_test%exe_ext < %S/std_collections_pure_wavl_test/map_basics.in | %FileCheck %s --check-prefix=MAP
// MAP:      1
// MAP-NEXT: 1
// MAP-NEXT: 1
// MAP-NEXT: 1
// MAP-NEXT: 1
// MAP-NEXT: 1
// MAP-NEXT: 1
// MAP-NEXT: 1

// The ordering cases print observations, not booleans: an empty container
// satisfies "is sorted" vacuously, so a boolean cannot distinguish a correct
// traversal from one that yields nothing. The two lengths bracket the fold —
// a defect that disturbs the tree while folding shows up as a second length
// that disagrees with the first, and the log names which one is wrong.
// RUN: %t.bdir/release/std_collections_pure_wavl_test%exe_ext < %S/std_collections_pure_wavl_test/set_order.in | %FileCheck %s --check-prefix=SETORD
// elements iterated before the fold
// SETORD:      7
// the seven keys in ascending order, folded into one number
// SETORD-NEXT: 1234789
// elements iterated after the fold
// SETORD-NEXT: 7
// from_list(to_list(s)) round-trip size
// SETORD-NEXT: 7
// strictly ascending
// SETORD-NEXT: 1

// RUN: %t.bdir/release/std_collections_pure_wavl_test%exe_ext < %S/std_collections_pure_wavl_test/map_order.in | %FileCheck %s --check-prefix=MAPORD
// entries iterated before the fold
// MAPORD:      4
// sum of key*100 + value over the four entries
// MAPORD-NEXT: 2420
// entries iterated after the fold
// MAPORD-NEXT: 4
// from_list(to_list(m)) round-trip, then get(9)
// MAPORD-NEXT: 90
// keys strictly ascending
// MAPORD-NEXT: 1

// RUN: %t.bdir/release/std_collections_pure_wavl_test%exe_ext < %S/std_collections_pure_wavl_test/churn.in | %FileCheck %s --check-prefix=CHURN
// CHURN:      1
// CHURN-NEXT: 1
