// Each input selects one persistent List unit case through the executable's
// dispatcher. New methods can be covered without changing existing cases.

// RUN: %rene build --manifest-path %S/std_collections_pure_list_test/rene.ncl --build-dir %t.bdir --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}std_collections_pure_list_test

// RUN: %t.bdir/release/std_collections_pure_list_test%exe_ext < %S/std_collections_pure_list_test/len.in | %FileCheck %s --check-prefix=LEN
// LEN:      1
// LEN-NEXT: 1

// RUN: %t.bdir/release/std_collections_pure_list_test%exe_ext < %S/std_collections_pure_list_test/head.in | %FileCheck %s --check-prefix=HEAD
// HEAD:      3
// HEAD-NEXT: -1

// RUN: %t.bdir/release/std_collections_pure_list_test%exe_ext < %S/std_collections_pure_list_test/tail.in | %FileCheck %s --check-prefix=TAIL
// TAIL:      1
// TAIL-NEXT: 1

// RUN: %t.bdir/release/std_collections_pure_list_test%exe_ext < %S/std_collections_pure_list_test/is_nil.in | %FileCheck %s --check-prefix=IS-NIL
// IS-NIL:      1
// IS-NIL-NEXT: 0

// RUN: %t.bdir/release/std_collections_pure_list_test%exe_ext < %S/std_collections_pure_list_test/is_cons.in | %FileCheck %s --check-prefix=IS-CONS
// IS-CONS:      0
// IS-CONS-NEXT: 1

// RUN: %t.bdir/release/std_collections_pure_list_test%exe_ext < %S/std_collections_pure_list_test/reverse.in | %FileCheck %s --check-prefix=REVERSE
// REVERSE:      2
// REVERSE-NEXT: 1
// REVERSE-NEXT: 3

// RUN: %t.bdir/release/std_collections_pure_list_test%exe_ext < %S/std_collections_pure_list_test/map.in | %FileCheck %s --check-prefix=MAP
// MAP:      4
// MAP-NEXT: 2
// MAP-NEXT: 3

// RUN: %t.bdir/release/std_collections_pure_list_test%exe_ext < %S/std_collections_pure_list_test/min.in | %FileCheck %s --check-prefix=MIN
// MIN:      1
// MIN-NEXT: -1
