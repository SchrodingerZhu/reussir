// Each input selects one persistent List unit case through the executable's
// dispatcher. New methods can be covered without changing existing cases.

// RUN: %rene build --manifest-path %S/std_collections_pure_list_test/rene.ncl --build-dir %t.bdir --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}std_collections_pure_list_test

// RUN: %t.bdir/release/std_collections_pure_list_test%exe_ext < %S/std_collections_pure_list_test/len.in | %FileCheck %s --check-prefix=LEN
// LEN:      1
// LEN-NEXT: 1

// RUN: %t.bdir/release/std_collections_pure_list_test%exe_ext < %S/std_collections_pure_list_test/head.in | %FileCheck %s --check-prefix=HEAD
// HEAD:      3
// HEAD-NEXT: -1

