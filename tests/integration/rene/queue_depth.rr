// REQUIRES: wasmer, wasip1
// RUN: %rene build --manifest-path %S/queue_depth/rene.ncl --build-dir %t.bdir --profile release --target wasm32-wasip1 | %FileCheck %s --check-prefix=LISTING
// RUN: %wasmer --stack-size 1048576 %t.bdir/release/queue_depth.wasm | %FileCheck %s
// RUN: %rene build --manifest-path %S/queue_depth/rene.ncl --build-dir %t.bdir --profile optimized --target wasm32-wasip1 | %FileCheck %s --check-prefix=LISTING
// RUN: %wasmer --stack-size 1048576 %t.bdir/optimized/queue_depth.wasm | %FileCheck %s
// LISTING: queue_depth.wasm
// CHECK: fq = 323752187

// The reproducer from #618: churn a 16-element Hood-Melville queue for
// 100,000 rounds with a tail-recursive driver returning a value enum.
// On wasm32 the Pop payload has padding. Constructing it with a non-entry
// alloca blocks LLVM's first tail-recursion pass, and later return-value
// repacking prevents another attempt from recovering the loop. The engine
// then exhausts its call stack despite the constant size of the queue.
//
// Both optimizing levels must form a loop and preserve the exact checksum.
// The profiles disable wasm tail calls, so this exercises loop conversion
// without relying on return_call or an experimental multivalue ABI.
