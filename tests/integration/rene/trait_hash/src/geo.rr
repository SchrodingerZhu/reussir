pub struct Point {
    pub x: u64,
    pub y: u64,
}

impl super::Hash for Point {
    fn hash<H: super::Hasher>(self: Self, state: H) -> H {
        super::write_u64(super::write_u64(state, self.x), self.y)
    }
}

pub struct Pair<A, B> {
    pub a: A,
    pub b: B,
}

impl<A: super::Hash, B: super::Hash> super::Hash for Pair<A, B> {
    fn hash<H: super::Hasher>(self: Self, state: H) -> H {
        self.b.hash(self.a.hash(state))
    }
}
