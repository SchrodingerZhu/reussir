// A downstream executable package exercises the generic Hood-Melville queue.
// Each input selects one public-API or incremental-rotation case.

// RUN: %rene build --manifest-path %S/std_collections_pure_rtqueue_test/rene.ncl --build-dir %t.bdir --profile release %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}std_collections_pure_rtqueue_test

// RUN: %t.bdir/release/std_collections_pure_rtqueue_test%exe_ext < %S/std_collections_pure_rtqueue_test/new.in | %FileCheck %s --check-prefix=NEW
// NEW:      1
// NEW-NEXT: 1
// NEW-NEXT: 1
// NEW-NEXT: 1

// RUN: %t.bdir/release/std_collections_pure_rtqueue_test%exe_ext < %S/std_collections_pure_rtqueue_test/snoc.in | %FileCheck %s --check-prefix=SNOC
// SNOC:      10
// SNOC-NEXT: 1
// SNOC-NEXT: 0

// RUN: %t.bdir/release/std_collections_pure_rtqueue_test%exe_ext < %S/std_collections_pure_rtqueue_test/uncons.in | %FileCheck %s --check-prefix=UNCONS
// UNCONS:      1
// UNCONS-NEXT: 2
// UNCONS-NEXT: 3
// UNCONS-NEXT: 1

// RUN: %t.bdir/release/std_collections_pure_rtqueue_test%exe_ext < %S/std_collections_pure_rtqueue_test/persistence.in | %FileCheck %s --check-prefix=PERSISTENCE
// PERSISTENCE:      1
// PERSISTENCE-NEXT: 1
// PERSISTENCE-NEXT: 4
// PERSISTENCE-NEXT: 4
// PERSISTENCE-NEXT: 456

// RUN: %t.bdir/release/std_collections_pure_rtqueue_test%exe_ext < %S/std_collections_pure_rtqueue_test/bulk_rotation.in | %FileCheck %s --check-prefix=BULK
// BULK:      1
// BULK-NEXT: 0
// BULK-NEXT: 1234567

// RUN: %t.bdir/release/std_collections_pure_rtqueue_test%exe_ext < %S/std_collections_pure_rtqueue_test/interleaved_rotation.in | %FileCheck %s --check-prefix=INTERLEAVED
// INTERLEAVED: 8128

// RUN: %t.bdir/release/std_collections_pure_rtqueue_test%exe_ext < %S/std_collections_pure_rtqueue_test/shared_payload.in | %FileCheck %s --check-prefix=SHARED
// SHARED:      7
// SHARED-NEXT: 11
// SHARED-NEXT: 1
