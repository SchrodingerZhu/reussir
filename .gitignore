# Rust / Cargo (the workspace target directory lives at the repo root)
/target
crates/**/target
runtime/target
rustc-ice-*
*.profraw
.cargo/*
# but keep the checked-in cargo config (build flags for snmalloc on MSVC, etc.)
!.cargo/config.toml

# Editors / IDEs
.idea
.vscode
!editors/vscode/.vscode/
!editors/vscode/.vscode/launch.json
!editors/vscode/.vscode/tasks.json
.clice

# Build trees
/build
/build-*
.cache
dist-*
# rene's per-package build directory and rrc's rust-module temp files, as the
# integration tests scatter both inside tests/integration/ packages
reussir-build/
reussir_rust_module_*

# Environment
.envrc
.direnv

# Misc tooling
_codeql_detected_source_root
node_modules
editors/vscode/dist/
editors/vscode/LICENSE
*.vsix

# Nix devShell auto-generated cmake preset (created by flake.nix shellHook)
CMakeUserPresets.json

# clangd symlink into build/
/compile_commands.json
