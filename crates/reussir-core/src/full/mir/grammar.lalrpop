//! Grammar for the textual Full (MIR) IR — the deserializer, dual to
//! `full::mir::print`. Tokens come from the `crate::ir_lex` logos lexer; productions
//! build the owned `full::mir::raw` AST, which `full::mir::build` re-interns into the
//! arena MIR. Covers every MIR form: functions, types, expressions, and
//! `match` decision trees.

use crate::full::mir::raw as raw;
use crate::ir_lex::{Token, LexError};

grammar<'input>;

pub Program: raw::Program = <items:Item*> => raw::Program::from_items(items);

Item: raw::Item = {
    "record" "@" <s:Sym> ":" <t:Ty> ";" => raw::Item::Record(s, t),
    <f:Func> => raw::Item::Func(f),
    "extern" <abi:"quoted"> "trampoline" <export:"quoted"> "=" "@" <target:Sym> ";"
        => raw::Item::Tramp(raw::Tramp { abi: abi.to_string(), export: export.to_string(), target }),
};

/// A symbol body (after `@`).
Sym: String = <s:"ident"> => s.to_string();

Func: raw::Func =
    <p:"pub"?> <r:"regional"?> "fn" "@" <symbol:Sym>
    "(" <params:Comma<Param>> ")" "->" <ret:Ty> <body:Body>
    => raw::Func { is_pub: p.is_some(), regional: r.is_some(), symbol, params, ret, body };

Body: Option<raw::Expr> = {
    "{" <b:Block> "}" => Some(b),
    ";" => None,
};

Param: raw::Param =
    <var:"var"> "(" <name:"ident"> ")" ":" <ty:Ty>
    => raw::Param { var, name: name.to_string(), ty };

// ----- types -----

Ty: raw::Ty = {
    <w:"ints"> => raw::Ty::Signed(w),
    <w:"intu"> => raw::Ty::Unsigned(w),
    <w:"fp"> => raw::Ty::Ieee(w),
    "bf16" => raw::Ty::BFloat16,
    "f8" => raw::Ty::Float8,
    "bool" => raw::Ty::Bool,
    "str" => raw::Ty::Str,
    "(" ")" => raw::Ty::Unit,
    "!" => raw::Ty::Bottom,
    "Nullable" "<" <t:Ty> ">" => raw::Ty::Nullable(Box::new(t)),
    <cap:Cap> <path:"ident"> <args:TyArgs?>
        => raw::Ty::Record { cap, path: path.to_string(), args: args.unwrap_or_default() },
    "(" <ps:CommaPlus<Ty>> ")" "->" <ret:Ty> => raw::Ty::Closure { params: ps, ret: Box::new(ret) },
};

TyArgs: Vec<raw::Ty> = "::" "<" <CommaPlus<Ty>> ">";

Cap: raw::Cap = {
    => raw::Cap::None,
    "[" "flex" "]" => raw::Cap::Flex,
    "[" "rigid" "]" => raw::Cap::Rigid,
    "[" "regional" "]" => raw::Cap::Regional,
};

// ----- expressions -----

/// A block body: `;`-separated statements; a single expression is not wrapped.
/// A multi-item block is a `Seq` typed by its last item (correct by
/// construction, so it needs no printed annotation).
Block: raw::Expr = <first:Expr> <rest:(";" <Expr>)*> => {
    if rest.is_empty() {
        first
    } else {
        let mut v = vec![first];
        v.extend(rest);
        let ty = v.last().unwrap().ty.clone();
        raw::Expr::new(raw::Kind::Seq(v), ty)
    }
};

/// Every value expression is `Atom : Ty` — the node's type is always printed and
/// read back, so no type is ever invented. `let` (always `unit`) and a braced
/// block (a `Seq`) are the two structural exceptions.
Expr: raw::Expr = {
    <a:Atom> ":" <t:Ty> => raw::Expr::new(a, t),
    "let" <var:"var"> "(" <name:"ident"> ")" "=" <value:Expr>
        => raw::Expr::new(raw::Kind::Let { var, name: name.to_string(), value }, raw::Ty::Unit),
    "{" <b:Block> "}" => b,
};

Atom: raw::Kind = {
    <n:"int"> => raw::Kind::ConstInt(n),
    <f:"float"> => raw::Kind::ConstFloat(f),
    "true" => raw::Kind::ConstBool(true),
    "false" => raw::Kind::ConstBool(false),
    <w:StrWords> => raw::Kind::GlobalStr(w),
    <v:"var"> => raw::Kind::Var(v),
    "poison" => raw::Kind::Poison,
    "-" "(" <e:Expr> ")" => raw::Kind::Negate(e),
    "!" "(" <e:Expr> ")" => raw::Kind::Not(e),
    "(" <l:Expr> <op:ArithOp> <r:Expr> ")" => raw::Kind::Arith(l, op, r),
    "(" <l:Expr> <op:CmpOp> <r:Expr> ")" => raw::Kind::Cmp(l, op, r),
    "(" <e:Expr> "as" <t:Ty> ")" => raw::Kind::Cast(e, t),
    "region" "{" <e:Expr> "}" => raw::Kind::RegionRun(e),
    "proj" "(" <base:Expr> <idxs:("," <"int">)*> ")"
        => raw::Kind::Proj(base, idxs.into_iter().map(|n| n as u32).collect()),
    "assign" "(" <dst:Expr> "," <field:"int"> "," <src:Expr> ")"
        => raw::Kind::Assign(dst, field as u32, src),
    <r:"regional"?> "@" <symbol:Sym> "(" <args:Comma<Expr>> ")"
        => raw::Kind::Call { regional: r.is_some(), symbol, args },
    "@" <symbol:Sym> "{" <args:Comma<Expr>> "}" => raw::Kind::Ctor { symbol, args },
    "@" <symbol:Sym> "::" "#" <v:"int"> "(" <args:Comma<Expr>> ")"
        => raw::Kind::Variant { symbol, variant: v as usize, args },
    "NonNull" "(" <e:Expr> ")" => raw::Kind::NullableCall(Some(e)),
    "Null" => raw::Kind::NullableCall(None),
    "apply" "(" <target:Expr> <args:("," <Expr>)*> ")"
        => raw::Kind::ClosureCall { target, args },
    "closure" "[" <captures:Comma<ClosureParam>> "]" "(" <params:Comma<ClosureParam>> ")" "{" <body:Expr> "}"
        => raw::Kind::Closure { captures, params, body },
    "if" <c:Expr> "then" "{" <t:Block> "}" "else" "{" <f:Block> "}"
        => raw::Kind::If(c, t, f),
    "match" <s:Expr> "{" <t:Tree> "}" => raw::Kind::Match(s, Box::new(t)),
};

ClosureParam: (u32, raw::Ty) = <v:"var"> ":" <t:Ty> => (v, t);

// ----- decision trees -----

Tree: raw::Tree = {
    "uncovered" => raw::Tree::Uncovered,
    "unreachable" => raw::Tree::Unreachable,
    "switch" <p:PatRef> "{" <arms:Arm*> "}" => raw::build_switch(p, arms),
    <b:Bindings> "=>" <body:Block> => raw::Tree::Leaf { bindings: b, body },
    <b:Bindings> "if" <g:Expr> "{" <s:Tree> "}" "else" "{" <f:Tree> "}"
        => raw::Tree::Guard { bindings: b, guard: g, success: Box::new(s), failure: Box::new(f) },
};

Arm: (raw::Label, raw::Tree) = <l:Label> "=>" "{" <t:Tree> "}" => (l, t);

Label: raw::Label = {
    "#" <n:"int"> => raw::Label::Ctor(n as usize),
    <n:"int"> => raw::Label::Int(n),
    "_" => raw::Label::Wildcard,
    "true" => raw::Label::Bool(true),
    "false" => raw::Label::Bool(false),
    <w:StrWords> => raw::Label::Str(w),
    "NonNull" => raw::Label::NonNull,
    "Null" => raw::Label::Null,
};

PatRef: raw::Path = "scrut" <idxs:("." <"int">)*>
    => idxs.into_iter().map(|n| n as u32).collect();

Bindings: Vec<raw::Binding> = <Binding*>;

Binding: raw::Binding = <v:"var"> "=" <p:PatRef> => (v, p);

// A string-literal tag: all four `StringToken` words, `_`-separated.
StrWords: raw::StrTag = "str" "#" <w0:"int"> "#" <w1:"int"> "#" <w2:"int"> "#" <w3:"int">
    => [w0 as u64, w1 as u64, w2 as u64, w3 as u64];

ArithOp: raw::ArithOp = {
    "+" => raw::ArithOp::Add,
    "-" => raw::ArithOp::Sub,
    "*" => raw::ArithOp::Mul,
    "/" => raw::ArithOp::Div,
    "%" => raw::ArithOp::Mod,
    "&&" => raw::ArithOp::And,
    "||" => raw::ArithOp::Or,
};

CmpOp: raw::CmpOp = {
    "<" => raw::CmpOp::Lt,
    ">" => raw::CmpOp::Gt,
    "<=" => raw::CmpOp::Le,
    ">=" => raw::CmpOp::Ge,
    "==" => raw::CmpOp::Eq,
    "!=" => raw::CmpOp::Ne,
};

// ----- shared helpers -----

/// Comma-separated, possibly empty, no trailing comma.
Comma<T>: Vec<T> = <mut v:(<T> ",")*> <last:T?> => {
    if let Some(l) = last { v.push(l); }
    v
};

/// Comma-separated, at least one element.
CommaPlus<T>: Vec<T> = <mut v:(<T> ",")*> <last:T> => {
    v.push(last);
    v
};

extern {
    type Location = usize;
    type Error = LexError;

    enum Token<'input> {
        "int" => Token::Int(<i128>),
        "float" => Token::Float(<f64>),
        "var" => Token::Var(<u32>),
        "ints" => Token::IntS(<u16>),
        "intu" => Token::IntU(<u16>),
        "fp" => Token::Fp(<u16>),
        "ident" => Token::Ident(<&'input str>),
        "quoted" => Token::Quoted(<&'input str>),
        "pub" => Token::Pub,
        "regional" => Token::Regional,
        "fn" => Token::Fn,
        "record" => Token::Record,
        "extern" => Token::Extern,
        "trampoline" => Token::Trampoline,
        "let" => Token::Let,
        "if" => Token::If,
        "then" => Token::Then,
        "else" => Token::Else,
        "match" => Token::Match,
        "switch" => Token::Switch,
        "scrut" => Token::Scrut,
        "uncovered" => Token::Uncovered,
        "unreachable" => Token::Unreachable,
        "region" => Token::Region,
        "as" => Token::As,
        "closure" => Token::Closure,
        "apply" => Token::Apply,
        "flex" => Token::Flex,
        "rigid" => Token::Rigid,
        "proj" => Token::Proj,
        "assign" => Token::Assign,
        "Nullable" => Token::Nullable,
        "NonNull" => Token::NonNull,
        "Null" => Token::Null,
        "poison" => Token::Poison,
        "true" => Token::True,
        "false" => Token::False,
        "bool" => Token::Bool,
        "str" => Token::Str,
        "bf16" => Token::BF16,
        "f8" => Token::F8,
        "(" => Token::LParen,
        ")" => Token::RParen,
        "{" => Token::LBrace,
        "}" => Token::RBrace,
        "[" => Token::LBracket,
        "]" => Token::RBracket,
        "<" => Token::Lt,
        ">" => Token::Gt,
        ":" => Token::Colon,
        "::" => Token::ColonColon,
        ";" => Token::Semi,
        "," => Token::Comma,
        "." => Token::Dot,
        "=" => Token::Eq,
        "=>" => Token::FatArrow,
        "_" => Token::Underscore,
        "->" => Token::Arrow,
        "@" => Token::At,
        "#" => Token::Hash,
        "+" => Token::Plus,
        "-" => Token::Minus,
        "*" => Token::Star,
        "/" => Token::Slash,
        "%" => Token::Percent,
        "&&" => Token::AndAnd,
        "||" => Token::OrOr,
        "<=" => Token::Le,
        ">=" => Token::Ge,
        "==" => Token::EqEq,
        "!=" => Token::Ne,
        "!" => Token::Bang,
    }
}
